# Notes By FSir - Supabase Environment Variables
# Copy these values into .env.local and replace with your Supabase Project details

PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Algolia Search Credentials
PUBLIC_ALGOLIA_APP_ID=your-algolia-app-id
PUBLIC_ALGOLIA_SEARCH_API_KEY=your-algolia-search-only-api-key
PUBLIC_ALGOLIA_INDEX_NAME=notes_by_fsir
PUBLIC_ALGOLIA_SITE_VERIFICATION=your-algolia-domain-verification-meta-tag-code
ALGOLIA_ADMIN_API_KEY=your-algolia-admin-api-key-local-indexing-only


