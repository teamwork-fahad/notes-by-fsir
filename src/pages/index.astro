---
const subjects = [
	{
		name: "PHP",
		icon: "🐘",
		description: "PHP notes, programs, examples and practicals.",
		href: "/php",
	},
	{
		name: "C",
		icon: "⚙️",
		description: "C programming notes, concepts and programs.",
		href: "/c",
	},
	{
		name: "C++",
		icon: "💻",
		description: "C++ concepts, OOP, programs and examples.",
		href: "/cpp",
	},
	{
		name: "Python",
		icon: "🐍",
		description: "Python programming notes and practical examples.",
		href: "/python",
	},
	{
		name: "MySQL",
		icon: "🗄️",
		description: "MySQL queries, database concepts and examples.",
		href: "/mysql",
	},
	{
		name: "DSA",
		icon: "🌳",
		description: "Data Structures and Algorithms notes and programs.",
		href: "/dsa",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Notes By FSir - Coding notes, programming tutorials, examples and practicals by Fahad Sir."
		/>
		<title>Notes By FSir | Coding Notes & Tutorials</title>
	</head>

	<body>
		<!-- NAVBAR -->
		<header class="navbar">
			<a href="/" class="logo">
				Notes By <span>FSir</span>
			</a>

			<nav>
				<a href="/">Home</a>
				<a href="#subjects">Subjects</a>
				<a href="#about">About</a>
			</nav>

			<div class="nav-actions">
				<button
					class="theme-btn"
					id="themeToggle"
					aria-label="Toggle theme"
				>
					🌙
				</button>

				<a href="/login" class="login-btn" id="navAuthBtn"> Login </a>
			</div>
		</header>

		<!-- HERO -->
		<main>
			<section class="hero">
				<div class="hero-content">
					<div class="brand-badge">👨‍🏫 By Fahad Sir</div>

					<p class="tag">📚 Learn • Practice • Grow</p>

					<h1>
						Coding Notes
						<br />
						<span>Made Simple.</span>
					</h1>

					<p class="hero-text">
						Easy-to-understand programming notes, practical
						programs, examples and tutorials for students.
					</p>

					<!-- SEARCH -->
					<div class="search-box">
						<span>🔍</span>
						<input
							type="text"
							placeholder="Search PHP, C, Python, MySQL..."
							aria-label="Search notes"
						/>
					</div>

					<div class="hero-buttons">
						<a href="#subjects" class="primary-btn">
							Explore Notes →
						</a>

						<a href="#about" class="secondary-btn">
							About Fahad Sir
						</a>
					</div>
				</div>
			</section>

			<!-- SUBJECTS -->
			<section class="subjects" id="subjects">
				<div class="section-heading">
					<p>START LEARNING</p>

					<h2>Explore Subjects</h2>

					<span> Choose a subject and start learning. </span>
				</div>

				<div class="subject-grid">
					{
						subjects.map((subject) => (
							<a href={subject.href} class="subject-card">
								<div class="subject-icon">{subject.icon}</div>

								<h3>{subject.name}</h3>

								<p>{subject.description}</p>

								<span class="read-more">View Notes →</span>
							</a>
						))
					}
				</div>
			</section>

			<!-- ABOUT -->
			<section class="about" id="about">
				<div class="about-left">
					<p class="small-title">ABOUT NOTES BY FSIR</p>

					<h2>
						Learn Coding.
						<br />
						Understand Concepts.
					</h2>

					<p class="teacher">👨‍🏫 Fahad Sir</p>
				</div>

				<div class="about-right">
					<p>
						Notes By FSir is a student-friendly learning platform
						created by Fahad Sir to provide simple and practical
						computer and programming notes.
					</p>

					<p>
						Our goal is to make programming easier to understand
						through clear explanations, examples, programs and
						practical learning.
					</p>
				</div>
			</section>

			<!-- FEATURES -->
			<section class="features">
				<div class="feature">
					<div>📖</div>
					<h3>Easy Notes</h3>
					<p>Simple explanations that are easy to understand.</p>
				</div>

				<div class="feature">
					<div>💻</div>
					<h3>Practical Programs</h3>
					<p>Learn concepts with real programming examples.</p>
				</div>

				<div class="feature">
					<div>🎓</div>
					<h3>Student Focused</h3>
					<p>Designed especially for students and beginners.</p>
				</div>
			</section>
		</main>

		<!-- FOOTER -->
		<footer>
			<div class="footer-logo">
				Notes By <span>FSir</span>
				</div>

			<p>Created with ❤️ by Fahad Sir</p>

			<p class="copyright">© 2026 Notes By FSir. All rights reserved.</p>
		</footer>

