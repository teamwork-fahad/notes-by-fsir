---
const subjects = [
	{
		name: "PHP",
		icon: "🐘",
		description: "PHP notes, programs, examples and practicals.",
		href: "/php",
	},
	{
		name: "C",
		icon: "⚙️",
		description: "C programming notes, concepts and programs.",
		href: "#",
	},
	{
		name: "C++",
		icon: "💻",
		description: "C++ concepts, OOP, programs and examples.",
		href: "#",
	},
	{
		name: "Python",
		icon: "🐍",
		description: "Python programming notes and practical examples.",
		href: "#",
	},
	{
		name: "MySQL",
		icon: "🗄️",
		description: "MySQL queries, database concepts and examples.",
		href: "#",
	},
	{
		name: "DSA",
		icon: "🌳",
		description: "Data Structures and Algorithms notes and programs.",
		href: "#",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Notes By FSir - Coding notes, programming tutorials, examples and practicals by Fahad Sir."
		/>
		<title>Notes By FSir | Coding Notes & Tutorials</title>
	</head>

	<body>
		<!-- NAVBAR -->
		<header class="navbar">
			<a href="/" class="logo">
				Notes By <span>FSir</span>
			</a>

			<nav>
				<a href="/">Home</a>
				<a href="#subjects">Subjects</a>
				<a href="#about">About</a>
			</nav>

			<div class="nav-actions">
				<button
					class="theme-btn"
					id="themeToggle"
					aria-label="Toggle theme"
				>
					🌙
				</button>

				<a href="/login" class="login-btn" id="navAuthBtn"> Login </a>
			</div>
		</header>

		<!-- HERO -->
		<main>
			<section class="hero">
				<div class="hero-content">
					<div class="brand-badge">👨‍🏫 By Fahad Sir</div>

					<p class="tag">📚 Learn • Practice • Grow</p>

					<h1>
						Coding Notes
						<br />
						<span>Made Simple.</span>
					</h1>

					<p class="hero-text">
						Easy-to-understand programming notes, practical
						programs, examples and tutorials for students.
					</p>

					<!-- SEARCH -->
					<div class="search-box">
						<span>🔍</span>
						<input
							type="text"
							placeholder="Search PHP, C, Python, MySQL..."
							aria-label="Search notes"
						/>
					</div>

					<div class="hero-buttons">
						<a href="#subjects" class="primary-btn">
							Explore Notes →
						</a>

						<a href="#about" class="secondary-btn">
							About Fahad Sir
						</a>
					</div>
				</div>
			</section>

			<!-- SUBJECTS -->
			<section class="subjects" id="subjects">
				<div class="section-heading">
					<p>START LEARNING</p>

					<h2>Explore Subjects</h2>

					<span> Choose a subject and start learning. </span>
				</div>

				<div class="subject-grid">
					{
						subjects.map((subject) => (
							<a href={subject.href} class="subject-card">
								<div class="subject-icon">{subject.icon}</div>

								<h3>{subject.name}</h3>

								<p>{subject.description}</p>

								<span class="read-more">View Notes →</span>
							</a>
						))
					}
				</div>
			</section>

			<!-- ABOUT -->
			<section class="about" id="about">
				<div class="about-left">
					<p class="small-title">ABOUT NOTES BY FSIR</p>

					<h2>
						Learn Coding.
						<br />
						Understand Concepts.
					</h2>

					<p class="teacher">👨‍🏫 Fahad Sir</p>
				</div>

				<div class="about-right">
					<p>
						Notes By FSir is a student-friendly learning platform
						created by Fahad Sir to provide simple and practical
						computer and programming notes.
					</p>

					<p>
						Our goal is to make programming easier to understand
						through clear explanations, examples, programs and
						practical learning.
					</p>
				</div>
			</section>

			<!-- FEATURES -->
			<section class="features">
				<div class="feature">
					<div>📖</div>
					<h3>Easy Notes</h3>
					<p>Simple explanations that are easy to understand.</p>
				</div>

				<div class="feature">
					<div>💻</div>
					<h3>Practical Programs</h3>
					<p>Learn concepts with real programming examples.</p>
				</div>

				<div class="feature">
					<div>🎓</div>
					<h3>Student Focused</h3>
					<p>Designed especially for students and beginners.</p>
				</div>
			</section>
		</main>

		<!-- FOOTER -->
		<footer>
			<div class="footer-logo">
				Notes By <span>FSir</span>
			</div>

			<p>Created with ❤️ by Fahad Sir</p>

			<p class="copyright">© 2026 Notes By FSir. All rights reserved.</p>
		</footer>

		<!-- THEME SCRIPT -->
		<script>
			const themeButton = document.getElementById("themeToggle");

			const savedTheme = localStorage.getItem("theme");

			if (savedTheme === "dark") {
				document.body.classList.add("dark");
				themeButton.textContent = "☀️";
			}

			themeButton?.addEventListener("click", () => {
				document.body.classList.toggle("dark");

				const isDark = document.body.classList.contains("dark");

				localStorage.setItem("theme", isDark ? "dark" : "light");

				themeButton.textContent = isDark ? "☀️" : "🌙";
			});
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		font-family:
			Inter,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;

		color: #172033;
		background: #ffffff;

		transition:
			background 0.25s ease,
			color 0.25s ease;
	}

	/* NAVBAR */

	.navbar {
		height: 72px;

		padding: 0 7%;

		display: flex;
		align-items: center;
		justify-content: space-between;

		border-bottom: 1px solid #e9ebf1;

		background: rgba(255, 255, 255, 0.95);

		position: sticky;
		top: 0;
		z-index: 100;

		backdrop-filter: blur(12px);
	}

	.logo {
		color: #172033;
		text-decoration: none;

		font-size: 22px;
		font-weight: 800;
	}

	.logo span,
	.footer-logo span {
		color: #5b4bdb;
	}

	nav {
		display: flex;
		gap: 32px;
	}

	nav a {
		color: #596174;
		text-decoration: none;

		font-size: 15px;
		font-weight: 600;
	}

	nav a:hover {
		color: #5b4bdb;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.theme-btn,
	.login-btn {
		border: 1px solid #dddff0;
		background: white;

		cursor: pointer;

		font-weight: 600;
	}

	.theme-btn {
		width: 40px;
		height: 40px;

		border-radius: 9px;

		font-size: 17px;
	}

	.login-btn {
		padding: 9px 18px;
		border-radius: 8px;
		text-decoration: none;
		color: #172033;
	}

	/* HERO */

	.hero {
		min-height: 680px;

		display: flex;
		align-items: center;
		justify-content: center;

		text-align: center;

		padding: 80px 20px;

		background:
			radial-gradient(circle at 20% 20%, #eeeaff 0, transparent 35%),
			radial-gradient(circle at 80% 30%, #fcecf6 0, transparent 35%),
			#ffffff;
	}

	.hero-content {
		max-width: 800px;
	}

	.brand-badge {
		display: inline-block;

		margin-bottom: 12px;

		padding: 7px 13px;

		border-radius: 30px;

		background: #ffffff;

		border: 1px solid #e6e2ff;

		color: #5b4bdb;

		font-size: 13px;

		font-weight: 700;
	}

	.tag {
		display: inline-block;

		margin-bottom: 22px;

		padding: 8px 14px;

		border-radius: 30px;

		background: #f2efff;

		color: #5b4bdb;

		font-size: 14px;

		font-weight: 700;
	}

	h1 {
		font-size: clamp(48px, 7vw, 78px);

		line-height: 1.05;

		letter-spacing: -3px;

		margin-bottom: 25px;
	}

	h1 span {
		color: #5b4bdb;
	}

	.hero-text {
		max-width: 620px;

		margin: auto;

		color: #697286;

		font-size: 18px;

		line-height: 1.7;
	}

	/* SEARCH */

	.search-box {
		max-width: 550px;

		margin: 30px auto 0;

		padding: 5px 7px 5px 17px;

		display: flex;
		align-items: center;

		gap: 10px;

		background: white;

		border: 1px solid #dedff0;

		border-radius: 12px;

		box-shadow: 0 10px 30px rgba(50, 40, 100, 0.08);
	}

	.search-box input {
		width: 100%;

		border: none;
		outline: none;

		padding: 12px 5px;

		font-size: 15px;

		background: transparent;

		color: #172033;
	}

	/* BUTTONS */

	.hero-buttons {
		margin-top: 25px;

		display: flex;

		justify-content: center;

		gap: 14px;
	}

	.primary-btn,
	.secondary-btn {
		text-decoration: none;

		padding: 13px 21px;

		border-radius: 9px;

		font-weight: 700;
	}

	.primary-btn {
		color: white;

		background: #5b4bdb;
	}

	.secondary-btn {
		color: #30384a;

		border: 1px solid #dddff0;

		background: white;
	}

	/* SUBJECTS */

	.subjects {
		max-width: 1150px;

		margin: auto;

		padding: 100px 25px;
	}

	.section-heading {
		text-align: center;

		margin-bottom: 45px;
	}

	.section-heading p,
	.small-title {
		color: #5b4bdb;

		font-size: 13px;

		font-weight: 800;

		letter-spacing: 1.5px;
	}

	.section-heading h2,
	.about h2 {
		margin: 8px 0;

		font-size: 38px;
	}

	.section-heading span {
		color: #7a8292;
	}

	.subject-grid {
		display: grid;

		grid-template-columns: repeat(3, 1fr);

		gap: 20px;
	}

	.subject-card {
		text-decoration: none;

		color: inherit;

		padding: 28px;

		border: 1px solid #e8eaf0;

		border-radius: 16px;

		background: white;

		transition: 0.2s ease;
	}

	.subject-card:hover {
		transform: translateY(-5px);

		border-color: #c9c2ff;

		box-shadow: 0 15px 35px rgba(50, 40, 100, 0.08);
	}

	.subject-icon {
		font-size: 34px;

		margin-bottom: 18px;
	}

	.subject-card h3 {
		font-size: 22px;

		margin-bottom: 10px;
	}

	.subject-card p {
		color: #737b8d;

		line-height: 1.6;

		min-height: 52px;
	}

	.read-more {
		display: inline-block;

		margin-top: 22px;

		color: #5b4bdb;

		font-weight: 700;

		font-size: 14px;
	}

	/* ABOUT */

	.about {
		max-width: 1050px;

		margin: 20px auto 90px;

		padding: 55px;

		display: grid;

		grid-template-columns: 1fr 1fr;

		gap: 60px;

		border-radius: 22px;

		background: #f7f6ff;
	}

	.about h2 {
		margin-top: 12px;

		line-height: 1.2;
	}

	.teacher {
		margin-top: 20px;

		font-weight: 700;

		color: #5b4bdb;
	}

	.about-right {
		color: #687185;

		line-height: 1.8;
	}

	.about-right p + p {
		margin-top: 15px;
	}

	/* FEATURES */

	.features {
		max-width: 1050px;

		margin: 0 auto 100px;

		padding: 0 25px;

		display: grid;

		grid-template-columns: repeat(3, 1fr);

		gap: 20px;
	}

	.feature {
		text-align: center;

		padding: 30px;

		border: 1px solid #e8eaf0;

		border-radius: 15px;
	}

	.feature div {
		font-size: 35px;

		margin-bottom: 12px;
	}

	.feature h3 {
		margin-bottom: 8px;
	}

	.feature p {
		color: #737b8d;

		line-height: 1.6;
	}

	/* FOOTER */

	footer {
		padding: 35px 20px;

		text-align: center;

		border-top: 1px solid #edf0f5;

		color: #7b8291;

		font-size: 14px;
	}

	.footer-logo {
		color: #172033;

		font-size: 20px;

		font-weight: 800;

		margin-bottom: 8px;
	}

	.copyright {
		margin-top: 8px;

		font-size: 13px;
	}

	/* DARK MODE */

	body.dark {
		color: #e8eaf0;

		background: #101116;
	}

	body.dark .navbar {
		background: rgba(16, 17, 22, 0.95);

		border-color: #282a33;
	}

	body.dark .logo,
	body.dark .footer-logo {
		color: #f0f1f5;
	}

	body.dark nav a {
		color: #aeb3c0;
	}

	body.dark .theme-btn,
	body.dark .login-btn,
	body.dark .secondary-btn,
	body.dark .brand-badge {
		background: #191a21;

		border-color: #30323d;

		color: #e8eaf0;
	}

	body.dark .hero {
		background:
			radial-gradient(circle at 20% 20%, #211d3b 0, transparent 35%),
			radial-gradient(circle at 80% 30%, #351f31 0, transparent 35%),
			#101116;
	}

	body.dark .tag {
		background: #211d3b;
	}

	body.dark .hero-text,
	body.dark .section-heading span {
		color: #aeb3c0;
	}

	body.dark .search-box {
		background: #191a21;

		border-color: #30323d;
	}

	body.dark .search-box input {
		color: #e8eaf0;
	}

	body.dark .subject-card,
	body.dark .feature {
		background: #17181e;

		border-color: #2b2d36;
	}

	body.dark .subject-card p,
	body.dark .feature p {
		color: #aeb3c0;
	}

	body.dark .about {
		background: #191a21;
	}

	body.dark .about-right {
		color: #aeb3c0;
	}

	body.dark footer {
		border-color: #282a33;

		color: #aeb3c0;
	}

	/* MOBILE */

	@media (max-width: 800px) {
		nav {
			display: none;
		}

		.subject-grid,
		.features {
			grid-template-columns: 1fr 1fr;
		}

		.about {
			grid-template-columns: 1fr;

			margin-left: 20px;
			margin-right: 20px;
		}
	}

	@media (max-width: 520px) {
		.navbar {
			padding: 0 20px;
		}

		.login-btn {
			display: none;
		}

		h1 {
			font-size: 48px;
		}

		.hero-buttons {
			flex-direction: column;
		}

		.subject-grid,
		.features {
			grid-template-columns: 1fr;
		}

		.about {
			padding: 30px;
		}
	}
</style>
