---
import { getCollection } from "astro:content";

const subjectDefinitions = [
	{ collection: "php", name: "PHP", icon: "🐘", description: "PHP notes, programs, examples and practicals.", href: "/php" },
	{ collection: "cpp", name: "C++", icon: "💻", description: "C++ concepts, OOP, programs and examples.", href: "/cpp" },
	{ collection: "python", name: "Python", icon: "🐍", description: "Python programming notes and practical examples.", href: "/python" },
	{ collection: "mysql", name: "MySQL", icon: "🗄️", description: "SQL queries, database concepts and exercises.", href: "/mysql" },
	{ collection: "dsa", name: "DSA", icon: "🌳", description: "Data Structures and Algorithms notes and programs.", href: "/dsa" },
	{ collection: "css", name: "CSS", icon: "🎨", description: "CSS fundamentals, layout and practical styling examples.", href: "/css" },
	{ collection: "html", name: "HTML", icon: "🌐", description: "HTML structure, elements and semantic web development.", href: "/html" },
	{ collection: "js", name: "JavaScript", icon: "⚡", description: "JavaScript concepts, browser APIs and Angular notes.", href: "/js" },
	{ collection: "maths", name: "Mathematics", icon: "📐", description: "Mathematics units, formulas and solved examples.", href: "/maths" },
	{ collection: "foc", name: "Computer Fundamentals", icon: "🖥️", description: "Computer fundamentals with clear unit-wise notes.", href: "/foc" },
	{ collection: "docs", name: "Documentation", icon: "📚", description: "Guides, references and practical documentation.", href: "/docs" },
];

const subjects = (await Promise.all(
	subjectDefinitions.map(async (subject) => ({
		...subject,
		count: (await getCollection(subject.collection as Parameters<typeof getCollection>[0])).length,
	})),
)).filter((subject) => subject.count > 0);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Notes By FSir - Coding notes, programming tutorials, examples and practicals by Fahad Sir."
		/>
		<title>Notes By FSir | Coding Notes & Tutorials</title>
	</head>

	<body>
		<!-- NAVBAR -->
		<header class="navbar">
			<a href="/" class="logo">
				Notes By <span>FSir</span>
			</a>

			<nav>
				<a href="/">Home</a>
				<a href="#subjects">Subjects</a>
				<a href="#about">About</a>
			</nav>

			<div class="nav-actions">
				<button
					class="theme-btn"
					id="themeToggle"
					aria-label="Toggle theme"
				>
					🌙
				</button>

				<a href="/login" class="login-btn" id="navAuthBtn"> Login </a>
			</div>
		</header>

		<!-- HERO -->
		<main>
			<section class="hero">
				<div class="hero-content">
					<div class="brand-badge">👨‍🏫 By Fahad Sir</div>

					<p class="tag">📚 Learn • Practice • Grow</p>

					<h1>
						Coding Notes
						<br />
						<span>Made Simple.</span>
					</h1>

					<p class="hero-text">
						Easy-to-understand programming notes, practical
						programs, examples and tutorials for students.
					</p>

					<!-- SEARCH -->
					<div class="search-box">
						<span>🔍</span>
						<input
							id="homeSearch"
							type="text"
							placeholder="Search PHP, C, Python, MySQL..."
							aria-label="Search notes"
						/>
					</div>

					<div class="hero-buttons">
						<a href="#subjects" class="primary-btn">
							Explore Notes →
						</a>

						<a href="#about" class="secondary-btn">
							About Fahad Sir
						</a>
					</div>
				</div>
			</section>

			<!-- SUBJECTS -->
			<section class="subjects" id="subjects">
				<div class="section-heading">
					<p>START LEARNING</p>

					<h2>Explore Subjects</h2>

					<span> Choose a subject and start learning. </span>
				</div>

				<div class="subject-grid">
					{
						subjects.map((subject) => (
							<a href={subject.href} class="subject-card">
								<div class="subject-icon">{subject.icon}</div>

								<h3>{subject.name}</h3>

								<p>{subject.description}</p>

								<span class="note-count">{subject.count} {subject.count === 1 ? "note" : "notes"}</span>

								<span class="read-more">View Notes →</span>
							</a>
						))
					}
				</div>
			</section>

			<!-- ABOUT -->
			<section class="about" id="about">
				<div class="about-left">
					<p class="small-title">ABOUT NOTES BY FSIR</p>

					<h2>
						Learn Coding.
						<br />
						Understand Concepts.
					</h2>

					<p class="teacher">👨‍🏫 Fahad Sir</p>
				</div>

				<div class="about-right">
					<p>
						Notes By FSir is a student-friendly learning platform
						created by Fahad Sir to provide simple and practical
						computer and programming notes.
					</p>

					<p>
						Our goal is to make programming easier to understand
						through clear explanations, examples, programs and
						practical learning.
					</p>
				</div>
			</section>

			<!-- FEATURES -->
			<section class="features">
				<div class="feature">
					<div>📖</div>
					<h3>Easy Notes</h3>
					<p>Simple explanations that are easy to understand.</p>
				</div>

				<div class="feature">
					<div>💻</div>
					<h3>Practical Programs</h3>
					<p>Learn concepts with real programming examples.</p>
				</div>

				<div class="feature">
					<div>🎓</div>
					<h3>Student Focused</h3>
					<p>Designed especially for students and beginners.</p>
				</div>
			</section>
		</main>

		<!-- FOOTER -->
		<footer>
			<div class="footer-logo">
				Notes By <span>FSir</span>
				</div>

			<p>Created with ❤️ by Fahad Sir</p>

			<p class="copyright">© 2026 Notes By FSir. All rights reserved.</p>
		</footer>

		<style>
			@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap");

			:root {
				--paper: #f6f1e9;
				--surface: #fffdf8;
				--ink: #17212b;
				--muted: #65717a;
				--line: #ded8ce;
				--coral: #e86d52;
				--teal: #176d6b;
				--yellow: #f2c94c;
				--shadow: 0 18px 45px rgba(35, 43, 47, 0.09);
			}

			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				background: var(--paper);
				color: var(--ink);
				font-family: "DM Sans", sans-serif;
				background-image: linear-gradient(rgba(23, 33, 43, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(23, 33, 43, 0.035) 1px, transparent 1px);
				background-size: 32px 32px;
			}

			body.dark {
				--paper: #152326;
				--surface: #1d3030;
				--ink: #f5f1e8;
				--muted: #aebdb9;
				--line: #385252;
				--shadow: 0 18px 45px rgba(0, 0, 0, 0.24);
				background-image: linear-gradient(rgba(245, 241, 232, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(245, 241, 232, 0.035) 1px, transparent 1px);
			}

			.navbar,
			main,
			footer {
				width: min(1120px, calc(100% - 48px));
				margin: 0 auto;
			}

			.navbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 24px 0;
				border-bottom: 1px solid var(--line);
			}

			.logo,
			.footer-logo {
				color: var(--ink);
				font-family: "Space Grotesk", sans-serif;
				font-size: 1.2rem;
				font-weight: 700;
				letter-spacing: 0;
				text-decoration: none;
			}

			.logo span,
			.footer-logo span {
				color: var(--coral);
			}

			nav {
				display: flex;
				gap: 30px;
			}

			nav a,
			.login-btn {
				color: var(--muted);
				font-size: 0.88rem;
				font-weight: 600;
				text-decoration: none;
				transition: color 180ms ease;
			}

			nav a:hover,
			.login-btn:hover {
				color: var(--coral);
			}

			.nav-actions {
				display: flex;
				align-items: center;
				gap: 18px;
			}

			.theme-btn {
				width: 38px;
				height: 38px;
				border: 1px solid var(--line);
				border-radius: 50%;
				background: var(--surface);
				cursor: pointer;
				font-size: 1rem;
			}

			.login-btn {
				padding: 10px 16px;
				border: 1px solid var(--ink);
				border-radius: 4px;
				color: var(--ink);
			}

			.hero {
				display: grid;
				min-height: 570px;
				align-items: center;
				padding: 82px 0 96px;
				background: radial-gradient(circle at 84% 35%, rgba(242, 201, 76, 0.42), transparent 18%), radial-gradient(circle at 92% 56%, rgba(23, 109, 107, 0.18), transparent 22%);
			}

			.hero-content {
				max-width: 700px;
				animation: rise 700ms ease both;
			}

			.brand-badge,
			.tag,
			.small-title,
			.section-heading > p {
				color: var(--teal);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}

			.brand-badge {
				display: inline-block;
				padding: 8px 12px;
				border: 1px solid rgba(23, 109, 107, 0.28);
				border-radius: 999px;
				background: rgba(255, 253, 248, 0.5);
			}

			.tag {
				margin: 34px 0 14px;
				color: var(--coral);
			}

			h1,
			h2,
			h3 {
				font-family: "Space Grotesk", sans-serif;
				letter-spacing: 0;
			}

			h1 {
				max-width: 760px;
				margin: 0;
				font-size: clamp(3.5rem, 8vw, 6.8rem);
				line-height: 0.94;
				letter-spacing: -0.06em;
			}

			h1 span {
				color: var(--coral);
			}

			.hero-text {
				max-width: 510px;
				margin: 28px 0 0;
				color: var(--muted);
				font-size: 1.12rem;
				line-height: 1.65;
			}

			.search-box {
				display: flex;
				align-items: center;
				gap: 12px;
				max-width: 530px;
				margin-top: 30px;
				padding: 5px 18px;
				border: 1px solid var(--line);
				border-radius: 4px;
				background: var(--surface);
				box-shadow: var(--shadow);
			}

			.search-box input {
				width: 100%;
				padding: 14px 0;
				border: 0;
				outline: 0;
				background: transparent;
				color: var(--ink);
				font: inherit;
			}

			.hero-buttons {
				display: flex;
				gap: 12px;
				margin-top: 24px;
			}

			.primary-btn,
			.secondary-btn {
				padding: 14px 20px;
				border-radius: 4px;
				font-weight: 700;
				text-decoration: none;
			}

			.primary-btn {
				background: var(--teal);
				color: #fffdf8;
			}

			.secondary-btn {
				border: 1px solid var(--line);
				color: var(--ink);
			}

			.subjects {
				padding: 86px 0;
				border-top: 1px solid var(--line);
			}

			.section-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 24px;
				margin-bottom: 34px;
			}

			.section-heading p {
				margin: 0;
			}

			.section-heading h2 {
				margin: 0 auto 0 0;
				font-size: 2.1rem;
			}

			.section-heading span {
				color: var(--muted);
				font-size: 0.95rem;
			}

			.subject-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 14px;
			}

			.subject-card {
				display: flex;
				min-height: 240px;
				flex-direction: column;
				padding: 25px;
				border: 1px solid var(--line);
				border-radius: 6px;
				background: var(--surface);
				color: var(--ink);
				text-decoration: none;
				transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
			}

			.subject-card:hover {
				border-color: var(--coral);
				box-shadow: var(--shadow);
				transform: translateY(-5px);
			}

			.subject-icon {
				font-size: 2rem;
			}

			.subject-card h3 {
				margin: 24px 0 8px;
				font-size: 1.4rem;
			}

			.subject-card p {
				margin: 0;
				color: var(--muted);
				font-size: 0.92rem;
				line-height: 1.55;
			}

			.note-count {
				margin-top: 16px;
				color: var(--teal);
				font-size: 0.78rem;
				font-weight: 700;
			}

			.read-more {
				margin-top: auto;
				padding-top: 22px;
				color: var(--coral);
				font-size: 0.82rem;
				font-weight: 700;
			}

			.about {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 80px;
				padding: 90px 0;
				border-top: 1px solid var(--line);
			}

			.about h2 {
				margin: 18px 0;
				font-size: clamp(2rem, 4vw, 3.4rem);
				line-height: 1;
			}

			.teacher {
				color: var(--coral);
				font-weight: 700;
			}

			.about-right {
				align-self: end;
				max-width: 480px;
				color: var(--muted);
				font-size: 1.05rem;
				line-height: 1.75;
			}

			.features {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 14px;
				padding-bottom: 88px;
			}

			.feature {
				padding: 28px 0;
				border-top: 3px solid var(--yellow);
			}

			.feature:nth-child(2) {
				border-color: var(--coral);
			}

			.feature:nth-child(3) {
				border-color: var(--teal);
			}

			.feature > div {
				font-size: 1.7rem;
			}

			.feature h3 {
				margin: 18px 0 8px;
				font-size: 1.1rem;
			}

			.feature p {
				margin: 0;
				color: var(--muted);
				line-height: 1.55;
			}

			footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 26px 0 34px;
				border-top: 1px solid var(--line);
				color: var(--muted);
				font-size: 0.82rem;
			}

			footer p {
				margin: 0;
			}

			@keyframes rise {
				from { opacity: 0; transform: translateY(18px); }
				to { opacity: 1; transform: translateY(0); }
			}

			@media (max-width: 720px) {
				.navbar,
				main,
				footer {
					width: min(100% - 32px, 560px);
				}

				nav {
					display: none;
				}

				.navbar {
					padding: 18px 0;
				}

				.hero {
					min-height: auto;
					padding: 68px 0 76px;
				}

				h1 {
					font-size: clamp(3.2rem, 16vw, 5.2rem);
				}

				.section-heading,
				.about,
				footer {
					display: block;
				}

				.section-heading span {
					display: block;
					margin-top: 10px;
				}

				.subject-grid,
				.features {
					grid-template-columns: 1fr;
				}

				.about-right {
					margin-top: 32px;
				}

				footer p {
					margin-top: 10px;
				}
			}
		</style>

		<!-- THEME SCRIPT -->
		<script>
			const themeButton = document.getElementById("themeToggle");

			const savedTheme = localStorage.getItem("theme");

			if (savedTheme === "dark") {
				document.body.classList.add("dark");
				if (themeButton) themeButton.textContent = "☀️";
			}

			themeButton?.addEventListener("click", () => {
				document.body.classList.toggle("dark");
				const isDark = document.body.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
				themeButton.textContent = isDark ? "☀️" : "🌙";
			});

			const homeSearch = document.getElementById("homeSearch") as HTMLInputElement | null;
			const subjectCards = Array.from(document.querySelectorAll(".subject-card"));
			homeSearch?.addEventListener("input", () => {
				const query = homeSearch.value.trim().toLowerCase();
				subjectCards.forEach((card) => {
					card.hidden = query !== "" && !card.textContent.toLowerCase().includes(query);
				});
			});
		</script>
	</body>
</html>