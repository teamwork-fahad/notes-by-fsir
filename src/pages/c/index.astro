---
import { getCollection } from "astro:content";
import SubjectIndex from "../../components/SubjectIndex.astro";
import { getSubjectBySlug } from "../../lib/subjects";

const meta = getSubjectBySlug("c");
if (!meta || meta.published === false) {
  return Astro.redirect("/");
}
const notes = await getCollection("c");
---
<SubjectIndex notes={notes} slug="c" label={meta.name} title={meta.name} description={meta.description} />

