---
import { getSupabaseConfig } from "../lib/supabase";
import "../styles/site.css";

const config = getSupabaseConfig();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Reset Password | Notes By FSir</title>
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<!-- NAVBAR -->
		<header class="navbar">
			<a href="/" class="logo">
				Notes By <span>FSir</span>
			</a>

			<div class="nav-actions">
				<button id="themeToggle" class="theme-btn" aria-label="Toggle dark mode">🌙</button>
				<a href="/login" class="back-btn">← Back to Login</a>
			</div>
		</header>

		<!-- MAIN CONTAINER -->
		<main class="login-wrapper">
			<div class="login-card">
				<div class="brand-badge">🔐 Account Recovery</div>
				
				<h1>Reset Password</h1>
				<p class="subtitle">Enter your new password below to update your account.</p>

				<div class="alert danger hidden" id="errorAlert"></div>
				<div class="alert success hidden" id="successAlert"></div>

				<form id="resetForm" class="login-form">
					<div class="form-group">
						<label for="newPassword">New Password</label>
						<input
							type="password"
							id="newPassword"
							name="newPassword"
							placeholder="At least 6 characters"
							required
							minlength="6"
						/>
					</div>

					<div class="form-group">
						<label for="confirmPassword">Confirm New Password</label>
						<input
							type="password"
							id="confirmPassword"
							name="confirmPassword"
							placeholder="Re-enter new password"
							required
							minlength="6"
						/>
					</div>

					<button type="submit" class="submit-btn" id="resetBtn">
						<span>Update Password</span>
					</button>
				</form>
			</div>
		</main>

		<!-- SCRIPT -->
		<script is:inline define:vars={{ supabaseUrl: config.url, supabaseKey: config.anonKey, isConfigured: config.isConfigured }}>
			// Theme Toggle
			const themeButton = document.getElementById("themeToggle");
			const savedTheme = localStorage.getItem("theme");

			if (savedTheme === "dark") {
				document.body.classList.add("dark");
				if (themeButton) themeButton.textContent = "☀️";
			}

			themeButton?.addEventListener("click", () => {
				document.body.classList.toggle("dark");
				const isDark = document.body.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
				themeButton.textContent = isDark ? "☀️" : "🌙";
			});

			let supabase = null;

			if (isConfigured && supabaseUrl && supabaseKey) {
				import("https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm")
					.then((mod) => {
						supabase = mod.createClient(supabaseUrl, supabaseKey);
					})
					.catch((err) => {
						console.error("Failed to load Supabase SDK", err);
					});
			}

			const resetForm = document.getElementById("resetForm");
			const resetBtn = document.getElementById("resetBtn");
			const errorAlert = document.getElementById("errorAlert");
			const successAlert = document.getElementById("successAlert");

			resetForm?.addEventListener("submit", async (e) => {
				e.preventDefault();
				if (errorAlert) errorAlert.classList.add("hidden");
				if (successAlert) successAlert.classList.add("hidden");

				if (!supabase) {
					if (errorAlert) {
						errorAlert.textContent = "Supabase client is not configured.";
						errorAlert.classList.remove("hidden");
					}
					return;
				}

				const newPassword = document.getElementById("newPassword").value;
				const confirmPassword = document.getElementById("confirmPassword").value;

				if (newPassword !== confirmPassword) {
					if (errorAlert) {
						errorAlert.textContent = "Passwords do not match. Please try again.";
						errorAlert.classList.remove("hidden");
					}
					return;
				}

				if (resetBtn) resetBtn.disabled = true;

				try {
					const { data, error } = await supabase.auth.updateUser({
						password: newPassword,
					});

					if (error) throw error;

					if (successAlert) {
						successAlert.innerHTML = `<strong>Password Updated Successfully!</strong> Redirecting to login...`;
						successAlert.classList.remove("hidden");
					}

					setTimeout(() => {
						window.location.href = "/login";
					}, 2000);

				} catch (err) {
					if (errorAlert) {
						errorAlert.textContent = err.message || "Failed to update password.";
						errorAlert.classList.remove("hidden");
					}
				} finally {
					if (resetBtn) resetBtn.disabled = false;
				}
			});
		</script>

		<style>
			:global(*) { box-sizing: border-box; margin: 0; padding: 0; }
			:global(body) {
				font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: #172033;
				background: #ffffff;
				transition: background 0.25s ease, color 0.25s ease;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}
			.navbar {
				height: 72px;
				padding: 0 7%;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid #e9ebf1;
				background: rgba(255, 255, 255, 0.95);
			}
			.logo { color: #172033; text-decoration: none; font-size: 22px; font-weight: 800; }
			.logo span { color: #5b4bdb; }
			.nav-actions { display: flex; align-items: center; gap: 12px; }
			.theme-btn, .back-btn {
				border: 1px solid #dddff0;
				background: white;
				cursor: pointer;
				font-weight: 600;
				font-size: 14px;
				text-decoration: none;
				color: #172033;
				border-radius: 8px;
			}
			.theme-btn { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
			.back-btn { padding: 8px 16px; }
			.login-wrapper {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 60px 20px;
				background: radial-gradient(circle at 20% 20%, #eeeaff 0, transparent 35%), #ffffff;
			}
			.login-card {
				width: 100%;
				max-width: 480px;
				background: #ffffff;
				border: 1px solid #e8eaf0;
				border-radius: 20px;
				padding: 40px 36px;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
			}
			.brand-badge {
				display: inline-block;
				margin-bottom: 16px;
				padding: 6px 14px;
				border-radius: 30px;
				background: #f2efff;
				border: 1px solid #e6e2ff;
				color: #5b4bdb;
				font-size: 13px;
				font-weight: 700;
			}
			h1 { font-size: 28px; font-weight: 800; color: #172033; margin-bottom: 6px; }
			.subtitle { color: #687185; font-size: 14px; margin-bottom: 24px; }
			.alert { padding: 14px 16px; border-radius: 10px; font-size: 14px; margin-bottom: 20px; }
			.alert.hidden { display: none; }
			.alert.danger { background: #fdf2f2; border: 1px solid #f8b4b4; color: #9b1c1c; }
			.alert.success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
			.login-form { display: flex; flex-direction: column; gap: 18px; }
			.form-group { display: flex; flex-direction: column; gap: 6px; }
			.form-group label { font-size: 14px; font-weight: 600; color: #333a4d; }
			.form-group input {
				width: 100%;
				padding: 12px 16px;
				border-radius: 10px;
				border: 1px solid #d9dde7;
				font-size: 15px;
				outline: none;
			}
			.submit-btn {
				width: 100%;
				padding: 13px;
				background: #5b4bdb;
				color: white;
				border: none;
				border-radius: 10px;
				font-size: 16px;
				font-weight: 700;
				cursor: pointer;
				margin-top: 10px;
			}
			body.dark { color: #e8eaf0; background: #101116; }
			body.dark .navbar { background: rgba(16, 17, 22, 0.95); border-color: #282a33; }
			body.dark .logo { color: #f0f1f5; }
			body.dark .login-card { background: #17181e; border-color: #2b2d36; }
			body.dark h1 { color: #f0f1f5; }
			body.dark .form-group input { background: #101116; border-color: #2b2d36; color: #e8eaf0; }
		</style>
	</body>
</html>
