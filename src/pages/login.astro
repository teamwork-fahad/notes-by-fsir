---
import { getSupabaseConfig } from "../lib/supabase";

const config = getSupabaseConfig();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Login | Notes By FSir</title>
		<meta
			name="description"
			content="Fahad Sir Admin & Student Login for Notes By FSir"
		/>
	</head>
	<body>
		<!-- NAVBAR -->
		<header class="navbar">
			<a href="/" class="logo">
				Notes By <span>FSir</span>
			</a>

			<nav>
				<a href="/">Home</a>
				<a href="/#subjects">Subjects</a>
				<a href="/#about">About</a>
			</nav>

			<div class="nav-actions">
				<button
					id="themeToggle"
					class="theme-btn"
					aria-label="Toggle dark mode"
				>
					🌙
				</button>
				<a href="/" class="back-btn">← Back to Site</a>
			</div>
		</header>

		<!-- MAIN CONTAINER -->
		<main class="login-wrapper">
			<div class="login-card">
				<div class="brand-badge">👨‍🏫 Fahad Sir Portal</div>
				
				<h1>Login</h1>
				<p class="subtitle">Fahad Sir Admin / Student Authentication</p>

				{
					!config.isConfigured && (
						<div class="alert warning" id="configWarning">
							<strong>⚙️ Supabase Setup Required:</strong>
							<p>
								Supabase environment variables are missing or incomplete. Please set <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> in your <code>.env.local</code> file.
							</p>
						</div>
					)
				}

				<div class="alert danger hidden" id="errorAlert"></div>
				<div class="alert success hidden" id="successAlert"></div>

				<form id="loginForm" class="login-form">
					<div class="form-group">
						<label for="email">Email Address</label>
						<input
							type="email"
							id="email"
							name="email"
							placeholder="e.g. fahad@fsir.com or student@fsir.com"
							required
						/>
					</div>

					<div class="form-group">
						<label for="password">Password</label>
						<input
							type="password"
							id="password"
							name="password"
							placeholder="Enter your password"
							required
						/>
					</div>

					<div class="form-actions">
						<button type="submit" class="submit-btn" id="loginBtn">
							<span>Login</span>
						</button>
						<button type="button" class="signup-toggle-btn" id="signupToggleBtn">
							Need an Account? Sign Up
						</button>
					</div>
				</form>

				<!-- STUDENT NOTICE -->
				<div class="student-info-box">
					<h3>🎓 Student Access</h3>
					<p>
						Students can browse all coding notes, search practical examples, and submit edit suggestions without any restrictions. Sign up to track your suggestions!
					</p>
				</div>
			</div>
		</main>

		<!-- FOOTER -->
		<footer>
			<div class="footer-logo">
				Notes By <span>FSir</span>
			</div>
			<p>Created with ❤️ by Fahad Sir</p>
			<p class="copyright">© 2026 Notes By FSir. All rights reserved.</p>
		</footer>

		<!-- CLIENT AUTH SCRIPT -->
		<script is:inline define:vars={{ supabaseUrl: config.url, supabaseKey: config.anonKey, isConfigured: config.isConfigured }}>
			// Theme Toggle Logic
			const themeButton = document.getElementById("themeToggle");
			const savedTheme = localStorage.getItem("theme");

			if (savedTheme === "dark") {
				document.body.classList.add("dark");
				if (themeButton) themeButton.textContent = "☀️";
			}

			themeButton?.addEventListener("click", () => {
				document.body.classList.toggle("dark");
				const isDark = document.body.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
				themeButton.textContent = isDark ? "☀️" : "🌙";
			});

			let isSignUpMode = false;
			const signupToggleBtn = document.getElementById("signupToggleBtn");
			const loginBtn = document.getElementById("loginBtn");

			signupToggleBtn?.addEventListener("click", () => {
				isSignUpMode = !isSignUpMode;
				if (loginBtn) {
					loginBtn.querySelector("span").textContent = isSignUpMode ? "Create Account" : "Login";
				}
				signupToggleBtn.textContent = isSignUpMode ? "Already have an account? Login" : "Need an Account? Sign Up";
			});

			// Supabase Initialization & Login Logic
			let supabase = null;

			if (isConfigured && supabaseUrl && supabaseKey) {
				import("https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm")
					.then((mod) => {
						supabase = mod.createClient(supabaseUrl, supabaseKey);
						checkExistingSession();
					})
					.catch((err) => {
						console.error("Failed to load Supabase client SDK", err);
					});
			}

			async function checkExistingSession() {
				if (!supabase) return;
				const { data: { session } } = await supabase.auth.getSession();
				if (session) {
					// User is already logged in, check role
					fetchRoleAndRedirect(session.user);
				}
			}

			async function fetchRoleAndRedirect(user) {
				if (!supabase) return;
				const errorAlert = document.getElementById("errorAlert");
				const successAlert = document.getElementById("successAlert");

				const { data: profile, error } = await supabase
					.from("profiles")
					.select("role")
					.eq("id", user.id)
					.single();

				if (error && error.code !== "PGRST116") {
					console.warn("Profile fetch warning:", error);
				}

				const role = profile?.role || "student";

				if (successAlert) {
					if (role === "admin") {
						successAlert.textContent = `Logged in successfully as ADMIN! Redirecting to Admin Dashboard...`;
						successAlert.className = "alert success";
					} else {
						successAlert.innerHTML = `Logged in as <strong>STUDENT</strong>. Redirecting to home... <br/><small>(Note: To make <strong>${user.email}</strong> an Admin, run the SQL update query in Supabase SQL Editor).</small>`;
						successAlert.className = "alert warning";
					}
					successAlert.classList.remove("hidden");
				}

				setTimeout(() => {
					if (role === "admin") {
						window.location.href = "/admin";
					} else {
						window.location.href = "/";
					}
				}, 1500);
			}

			const loginForm = document.getElementById("loginForm");
			loginForm?.addEventListener("submit", async (e) => {
				e.preventDefault();
				const errorAlert = document.getElementById("errorAlert");
				const successAlert = document.getElementById("successAlert");
				
				if (errorAlert) errorAlert.classList.add("hidden");
				if (successAlert) successAlert.classList.add("hidden");

				if (!isConfigured || !supabase) {
					if (errorAlert) {
						errorAlert.innerHTML = `<strong>Configuration Required:</strong> Please set your <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> in <code>.env.local</code> first.`;
						errorAlert.classList.remove("hidden");
					}
					return;
				}

				const email = document.getElementById("email").value.trim();
				const password = document.getElementById("password").value;

				if (loginBtn) loginBtn.disabled = true;

				try {
					if (isSignUpMode) {
						const { data, error } = await supabase.auth.signUp({
							email,
							password
						});

						if (error) throw error;

						if (successAlert) {
							successAlert.textContent = "Account created successfully! Logging you in...";
							successAlert.classList.remove("hidden");
						}

						if (data.user) {
							await fetchRoleAndRedirect(data.user);
						}
					} else {
						const { data, error } = await supabase.auth.signInWithPassword({
							email,
							password
						});

						if (error) throw error;

						if (data.user) {
							await fetchRoleAndRedirect(data.user);
						}
					}
				} catch (err) {
					if (errorAlert) {
						errorAlert.textContent = err.message || "Authentication failed. Please check your credentials.";
						errorAlert.classList.remove("hidden");
					}
				} finally {
					if (loginBtn) loginBtn.disabled = false;
				}
			});
		</script>

		<style>
			:global(*) {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			:global(body) {
				font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: #172033;
				background: #ffffff;
				transition: background 0.25s ease, color 0.25s ease;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			/* NAVBAR */
			.navbar {
				height: 72px;
				padding: 0 7%;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid #e9ebf1;
				background: rgba(255, 255, 255, 0.95);
				position: sticky;
				top: 0;
				z-index: 100;
				backdrop-filter: blur(12px);
			}

			.logo {
				color: #172033;
				text-decoration: none;
				font-size: 22px;
				font-weight: 800;
			}

			.logo span, .footer-logo span {
				color: #5b4bdb;
			}

			nav {
				display: flex;
				gap: 32px;
			}

			nav a {
				color: #596174;
				text-decoration: none;
				font-size: 15px;
				font-weight: 600;
			}

			nav a:hover {
				color: #5b4bdb;
			}

			.nav-actions {
				display: flex;
				align-items: center;
				gap: 12px;
			}

			.theme-btn, .back-btn {
				border: 1px solid #dddff0;
				background: white;
				cursor: pointer;
				font-weight: 600;
				font-size: 14px;
				text-decoration: none;
				color: #172033;
			}

			.theme-btn {
				width: 40px;
				height: 40px;
				border-radius: 9px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 17px;
			}

			.back-btn {
				padding: 8px 16px;
				border-radius: 8px;
				transition: all 0.2s ease;
			}

			.back-btn:hover {
				border-color: #5b4bdb;
				color: #5b4bdb;
			}

			/* LOGIN WRAPPER */
			.login-wrapper {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 60px 20px;
				background:
					radial-gradient(circle at 20% 20%, #eeeaff 0, transparent 35%),
					radial-gradient(circle at 80% 30%, #fcecf6 0, transparent 35%),
					#ffffff;
			}

			.login-card {
				width: 100%;
				max-width: 480px;
				background: #ffffff;
				border: 1px solid #e8eaf0;
				border-radius: 20px;
				padding: 40px 36px;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
			}

			.brand-badge {
				display: inline-block;
				margin-bottom: 16px;
				padding: 6px 14px;
				border-radius: 30px;
				background: #f2efff;
				border: 1px solid #e6e2ff;
				color: #5b4bdb;
				font-size: 13px;
				font-weight: 700;
			}

			h1 {
				font-size: 30px;
				font-weight: 800;
				color: #172033;
				margin-bottom: 6px;
			}

			.subtitle {
				color: #687185;
				font-size: 15px;
				margin-bottom: 24px;
			}

			/* ALERTS */
			.alert {
				padding: 14px 16px;
				border-radius: 10px;
				font-size: 14px;
				margin-bottom: 20px;
				line-height: 1.5;
			}

			.alert.hidden {
				display: none;
			}

			.alert.warning {
				background: #fff8e6;
				border: 1px solid #ffe8b3;
				color: #8a6d3b;
			}

			.alert.danger {
				background: #fdf2f2;
				border: 1px solid #f8b4b4;
				color: #9b1c1c;
			}

			.alert.success {
				background: #f0fdf4;
				border: 1px solid #bbf7d0;
				color: #166534;
			}

			.alert code {
				background: rgba(0,0,0,0.06);
				padding: 2px 6px;
				border-radius: 4px;
				font-family: monospace;
			}

			/* FORM */
			.login-form {
				display: flex;
				flex-direction: column;
				gap: 20px;
			}

			.form-group {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}

			.form-group label {
				font-size: 14px;
				font-weight: 600;
				color: #333a4d;
			}

			.form-group input {
				width: 100%;
				padding: 12px 16px;
				border-radius: 10px;
				border: 1px solid #d9dde7;
				font-size: 15px;
				outline: none;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}

			.form-group input:focus {
				border-color: #5b4bdb;
				box-shadow: 0 0 0 3px rgba(91, 75, 219, 0.15);
			}

			.form-actions {
				display: flex;
				flex-direction: column;
				gap: 12px;
				margin-top: 10px;
			}

			.submit-btn {
				width: 100%;
				padding: 13px;
				background: #5b4bdb;
				color: white;
				border: none;
				border-radius: 10px;
				font-size: 16px;
				font-weight: 700;
				cursor: pointer;
				transition: background 0.2s ease, transform 0.1s ease;
			}

			.submit-btn:hover {
				background: #4a3ac7;
			}

			.submit-btn:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}

			.signup-toggle-btn {
				background: transparent;
				border: none;
				color: #5b4bdb;
				font-size: 14px;
				font-weight: 600;
				cursor: pointer;
				text-decoration: underline;
			}

			/* STUDENT INFO */
			.student-info-box {
				margin-top: 30px;
				padding-top: 24px;
				border-top: 1px solid #eef0f5;
			}

			.student-info-box h3 {
				font-size: 15px;
				font-weight: 700;
				color: #333a4d;
				margin-bottom: 6px;
			}

			.student-info-box p {
				font-size: 13px;
				color: #687185;
				line-height: 1.6;
			}

			/* FOOTER */
			footer {
				padding: 35px 20px;
				text-align: center;
				border-top: 1px solid #edf0f5;
				color: #7b8291;
				font-size: 14px;
			}

			.footer-logo {
				color: #172033;
				font-size: 20px;
				font-weight: 800;
				margin-bottom: 8px;
			}

			.copyright {
				margin-top: 8px;
				font-size: 13px;
			}

			/* DARK MODE STYLES */
			body.dark {
				color: #e8eaf0;
				background: #101116;
			}

			body.dark .navbar {
				background: rgba(16, 17, 22, 0.95);
				border-color: #282a33;
			}

			body.dark .logo, body.dark .footer-logo {
				color: #f0f1f5;
			}

			body.dark nav a {
				color: #aeb3c0;
			}

			body.dark .theme-btn, body.dark .back-btn {
				background: #191a21;
				border-color: #30323d;
				color: #e8eaf0;
			}

			body.dark .login-wrapper {
				background:
					radial-gradient(circle at 20% 20%, #211d3b 0, transparent 35%),
					radial-gradient(circle at 80% 30%, #351f31 0, transparent 35%),
					#101116;
			}

			body.dark .login-card {
				background: #17181e;
				border-color: #2b2d36;
			}

			body.dark h1 {
				color: #f0f1f5;
			}

			body.dark .subtitle, body.dark .student-info-box p {
				color: #aeb3c0;
			}

			body.dark .form-group label, body.dark .student-info-box h3 {
				color: #e8eaf0;
			}

			body.dark .form-group input {
				background: #101116;
				border-color: #2b2d36;
				color: #e8eaf0;
			}

			body.dark .brand-badge {
				background: #211d3b;
				border-color: #352b6d;
			}

			body.dark .student-info-box {
				border-top-color: #282a33;
			}

			body.dark footer {
				border-color: #282a33;
				color: #aeb3c0;
			}

			@media (max-width: 520px) {
				nav {
					display: none;
				}
				.login-card {
					padding: 30px 20px;
				}
			}
		</style>
	</body>
</html>
