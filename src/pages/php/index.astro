		background: #f0edff;
		color: #5b4bdb;
		font-weight: 900;
	}

	.note-link h3 {
		margin-bottom: 6px;
		font-size: 19px;
		line-height: 1.3;
	}

	.note-link p {
		color: #687185;
		line-height: 1.6;
	}

	.note-link small {
		display: inline-block;
		margin-top: 10px;
		color: #858c9b;
		font-weight: 700;
	}

	.empty-state {
		padding: 30px;
		text-align: center;
		border: 1px solid #e5e7ed;
		border-radius: 14px;
		background: white;
		color: #687185;
		font-weight: 700;
	}

	footer {
		padding: 35px 20px;
		text-align: center;
		border-top: 1px solid #edf0f5;
		color: #7b8291;
		font-size: 14px;
	}

	.footer-logo {
		margin-bottom: 8px;
		color: #172033;
		font-size: 20px;
		font-weight: 800;
	}

	footer small {
		display: block;
		margin-top: 8px;
