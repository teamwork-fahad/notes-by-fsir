	}

	.page-wrapper {
		width: min(calc(100% - 40px), 1120px);
		margin: auto;
		padding: 35px 0 90px;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 9px;
		margin-bottom: 25px;
