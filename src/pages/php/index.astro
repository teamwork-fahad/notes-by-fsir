		border: 1px solid #e5e7ed;
		border-radius: 16px;
		background: white;
		box-shadow: 0 8px 25px rgba(30, 35, 60, 0.04);
	}

	.chapter-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 18px;
		padding-bottom: 16px;
		border-bottom: 1px solid #eceef3;
	}

	.chapter-heading p {
		margin-bottom: 4px;
		color: #5b4bdb;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 1.2px;
		text-transform: uppercase;
	}

	.chapter-heading h2 {
		font-size: 26px;
		line-height: 1.2;
	}

	.chapter-heading span {
		flex: 0 0 auto;
		padding: 7px 11px;
		border-radius: 999px;
		background: #f0edff;
		color: #5b4bdb;
		font-size: 12px;
