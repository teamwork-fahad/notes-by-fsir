---
import { getCollection } from "astro:content";

const notes = await getCollection("php");

const getChapterNumber = (chapter: string) => {
	const [chapterNumber] = chapter.split(".");
	return chapterNumber || chapter;
};

const getSortValue = (chapter: string) => {
	const value = Number.parseFloat(chapter);
	return Number.isNaN(value) ? Number.MAX_SAFE_INTEGER : value;
};

const sortedNotes = notes
	.map((note) => ({
		id: note.id,
		url: `/php/${note.id}/`,
		title: note.data.title,
		description: note.data.description,
		subject: note.data.subject,
		chapter: note.data.chapter,
		author: note.data.author,
		chapterGroup: getChapterNumber(note.data.chapter),
		sortValue: getSortValue(note.data.chapter),
	}))
	.sort((a, b) => a.sortValue - b.sortValue || a.title.localeCompare(b.title));

const chapterMap = new Map<string, typeof sortedNotes>();

for (const note of sortedNotes) {
	if (!chapterMap.has(note.chapterGroup)) {
		chapterMap.set(note.chapterGroup, []);
	}

	chapterMap.get(note.chapterGroup)?.push(note);
}

const chapters = Array.from(chapterMap.entries()).map(([chapter, items]) => ({
	chapter,
	items,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="PHP programming notes and tutorials by Fahad Sir."
		/>
		<title>PHP Programming | Notes By FSir</title>
	</head>

	<body>
		<header class="navbar">
			<a href="/" class="logo">
				Notes By <span>FSir</span>
			</a>

			<nav>
				<a href="/">Home</a>
				<a href="/#subjects">Subjects</a>
				<a href="/#about">About</a>
			</nav>

			<div class="nav-actions">
				<button
					id="themeToggle"
					class="theme-btn"
					aria-label="Toggle dark mode"
				>
					moon
				</button>

				<a href="/login" class="back-btn">Login</a>
				<a href="/" class="back-btn">Back to Home</a>
			</div>
		</header>

		<main class="page-wrapper">
			<div class="breadcrumb">
				<a href="/">Home</a>
				<span>/</span>
				<span>PHP</span>
			</div>

			<section class="hero">
				<div>
					<p class="eyebrow">PHP NOTES</p>
					<h1>PHP Programming</h1>
					<p>
						Learn PHP from basics to advanced with clear chapters,
						examples, and practical notes by Fahad Sir.
					</p>
				</div>

				<div class="stats-panel">
					<span>{sortedNotes.length}</span>
					<p>Total Notes</p>
				</div>
			</section>

			<section class="tools" aria-label="Search PHP notes">
				<div class="search-box">
					<span>Search</span>
					<input
						id="noteSearch"
						type="search"
						placeholder="Search notes by title..."
						aria-label="Search notes by title"
					/>
				</div>
			</section>

			<section class="chapters" id="chapterList">
				{
					chapters.map(({ chapter, items }) => (
						<section class="chapter-card" data-chapter-card>
							<div class="chapter-heading">
								<div>
									<p>Chapter {chapter}</p>
									<h2>Chapter {chapter}</h2>
								</div>

								<span>{items.length} notes</span>
							</div>

							<div class="note-list">
								{items.map((note) => (
									<a
										href={note.url}
										class="note-link"
										data-note-link
										data-title={note.title.toLowerCase()}
									>
										<div class="note-number">
											{note.chapter}
										</div>

										<div>
											<h3>{note.title}</h3>
											<p>{note.description}</p>
											<small>By {note.author}</small>
										</div>
									</a>
								))}
							</div>
						</section>
					))
				}

				<p class="empty-state" id="emptyState" hidden>
					No PHP notes found.
				</p>
			</section>
		</main>

		<footer>
			<div class="footer-logo">
				Notes By <span>FSir</span>
			</div>

			<p>Created by Fahad Sir</p>
			<small>© 2026 Notes By FSir. All rights reserved.</small>
		</footer>

		<script>
			const themeButton = document.getElementById("themeToggle");
			const savedTheme = localStorage.getItem("theme");

			const setThemeButtonText = () => {
				if (!themeButton) return;

				themeButton.textContent = document.body.classList.contains("dark")
					? "sun"
					: "moon";
			};

			if (savedTheme === "dark") {
				document.body.classList.add("dark");
			}

			setThemeButtonText();

			themeButton?.addEventListener("click", () => {
				document.body.classList.toggle("dark");

				const isDark = document.body.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
				setThemeButtonText();
			});

			const searchInput = document.getElementById("noteSearch");
			const chapterCards = Array.from(
				document.querySelectorAll("[data-chapter-card]"),
			);
			const emptyState = document.getElementById("emptyState");

			searchInput?.addEventListener("input", () => {
				const query = searchInput.value.trim().toLowerCase();
				let visibleNotes = 0;

				chapterCards.forEach((chapterCard) => {
					const noteLinks = Array.from(
						chapterCard.querySelectorAll("[data-note-link]"),
					);

					let visibleInChapter = 0;

					noteLinks.forEach((noteLink) => {
						const title = noteLink.getAttribute("data-title") || "";
						const isVisible = title.includes(query);

						noteLink.hidden = !isVisible;

						if (isVisible) {
							visibleInChapter += 1;
							visibleNotes += 1;
						}
					});

					chapterCard.hidden = visibleInChapter === 0;
				});

				if (emptyState) {
					emptyState.hidden = visibleNotes > 0;
				}
			});
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		font-family:
			Inter,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
		background: #f7f8fc;
		color: #172033;
		transition:
			background 0.25s ease,
			color 0.25s ease;
	}

