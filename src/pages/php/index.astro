	}

	.navbar nav a {
		color: #596174;
		text-decoration: none;
		font-size: 15px;
		font-weight: 600;
	}

	.navbar nav a:hover {
		color: #5b4bdb;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.theme-btn,
	.back-btn {
		border: 1px solid #dddff0;
		background: white;
		color: #30384a;
		font-weight: 700;
	}

