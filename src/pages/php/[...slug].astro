    body.dark .content :global(h2),
    body.dark .content :global(h3),
    body.dark .content :global(strong) {
        color: #f0f1f5;
    }

    body.dark .description,
    body.dark .content :global(p),
    body.dark .content :global(li) {
        color: #aeb3c0;
    }

    body.dark .toc-card {
        background: #17181e;

        border-color: #2b2d36;
    }

    body.dark .toc-title {
        border-color: #30323d;
    }

    body.dark .toc-link {
        color: #9ca3b3;
    }

    body.dark .toc-link:hover {
        background: #211f32;

        color: #b7adff;
    }

    body.dark .toc-link.active {
        background: #25213b;

        color: #b7adff;
    }

    body.dark .content :global(code) {
        background: #24252d;

        color: #ff8ba3;
    }

    body.dark .content :global(table) {
        border-color: #343640;
    }

    body.dark .content :global(th),
    body.dark .content :global(td) {
        border-color: #343640;
    }

