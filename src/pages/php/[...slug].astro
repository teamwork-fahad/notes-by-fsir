        padding: 45px 20px;

        text-align: center;

        background: white;

        border-top: 1px solid #e7e9ef;

        color: #7b8291;
    }

    .footer-logo {
        margin-bottom: 8px;

        color: #202534;

        font-size: 20px;

        font-weight: 800;
    }

    footer small {
        display: block;

        margin-top: 8px;
    }

    /* =========================================
     DARK MODE
  ========================================= */

    body.dark {
        background: #101116;

        color: #e8eaf0;
    }

    body.dark .navbar {
        background: rgba(16, 17, 22, 0.94);

        border-color: #292b34;
    }

    body.dark .logo {
        color: #f0f1f5;
    }

