---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("php");

    return posts.map((post) => ({
        params: {
            slug: post.id,
        },
        props: {
            post,
        },
    }));
}

const { post } = Astro.props;

const { Content, headings } = await render(post);

// Only H2 and H3 headings for the table of contents
const tocItems = headings.filter(
    (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>{post.data.title} | Notes By FSir</title>

        <meta name="description" content={post.data.description} />
    </head>

    <body>
        <!-- NAVBAR -->

        <header class="navbar">
            <a href="/" class="logo">
                Notes By <span>FSir</span>
            </a>

            <nav>
                <a href="/">Home</a>
                <a href="/#subjects">Subjects</a>
            </nav>

            <div class="nav-actions">
                <button
                    id="themeToggle"
                    class="theme-btn"
                    aria-label="Toggle dark mode"
                >
                    🌙
                </button>

                <a href="/" class="back-btn"> ← Home </a>
            </div>
        </header>

        <!-- PAGE -->

        <main class="page-wrapper">
            <!-- BREADCRUMB -->

            <div class="breadcrumb">
                <a href="/">Home</a>

                <span>/</span>

                <a href="/#subjects">
                    {post.data.subject}
                </a>

                <span>/</span>

                <span>{post.data.chapter}</span>
            </div>

            <!-- LAYOUT -->

            <div class="layout">
                <!-- ARTICLE -->

                <article class="article">
                    <!-- ARTICLE HEADER -->

                    <div class="article-header">
                        <div class="article-meta">
                            <span class="subject-badge">
                                {post.data.subject}
                            </span>

                            <span class="author">
                                👨‍🏫 {post.data.author}
                            </span>
                        </div>

                        <h1>
                            {post.data.title}
                        </h1>

                        <p class="description">
                            {post.data.description}
                        </p>
                    </div>

                    <!-- PROGRESS BAR -->

                    <div class="reading-progress">
                        <div id="progressBar"></div>
                    </div>

                    <!-- CONTENT -->

                    <div class="content">
                        <Content />
                    </div>

                    <!-- END NOTE -->

                    <div class="end-note">
                        <div class="end-icon">✓</div>

                        <div>
                            <strong> Topic Completed </strong>

                            <p>Keep learning and practicing.</p>
                        </div>
                    </div>
                </article>

                <!-- TABLE OF CONTENTS -->

                <aside class="toc-container">
                    <div class="toc-card">
                        <div class="toc-title">
                            <div>
                                <span class="toc-icon">☰</span>
                                <strong>On this page</strong>
                            </div>

                            <span class="toc-count">
                                {tocItems.length}
                            </span>
                        </div>

                        <nav id="toc">
                            {
                                tocItems.map((item) => (
                                    <a
                                        href={`#${item.slug}`}
                                        class:list={[
                                            "toc-link",
                                            {
                                                "toc-h3": item.depth === 3,
                                            },
                                        ]}
                                        data-target={item.slug}
                                    >
                                        {item.text}
                                    </a>
                                ))
                            }
                        </nav>
                    </div>
                </aside>
            </div>
        </main>

        <!-- FOOTER -->

        <footer>
            <div class="footer-logo">
                Notes By <span>FSir</span>
            </div>

            <p>Created with ❤️ by Fahad Sir</p>

            <small> © 2026 Notes By FSir. All rights reserved. </small>
        </footer>

        <!-- JAVASCRIPT -->

        <script>
            // =====================================
            // DARK MODE
            // =====================================

            const themeToggle = document.getElementById("themeToggle");

            const savedTheme = localStorage.getItem("notes-theme");

            if (savedTheme === "dark") {
                document.body.classList.add("dark");

                if (themeToggle) {
                    themeToggle.textContent = "☀️";
                }
            }

            themeToggle?.addEventListener("click", () => {
                document.body.classList.toggle("dark");

                const isDark = document.body.classList.contains("dark");

                localStorage.setItem("notes-theme", isDark ? "dark" : "light");

                if (themeToggle) {
                    themeToggle.textContent = isDark ? "☀️" : "🌙";
                }
            });

            // =====================================
            // SMOOTH TOC SCROLL + ACTIVE ITEM
            // =====================================

            const tocLinks = Array.from(document.querySelectorAll(".toc-link"));
            const sections = Array.from(
                document.querySelectorAll(".content h2, .content h3"),
            );
            const offset = 100;

            function updateActiveToc() {
                let currentId = sections[0]?.id || "";
                const scrollPosition = window.scrollY + offset + 2;

                sections.forEach((section) => {
                    if (section.offsetTop <= scrollPosition) {
                        currentId = section.id;
                    }
                });

                tocLinks.forEach((link) => {
                    const targetId = link.getAttribute("data-target");
                    link.classList.toggle(
                        "active",
                        targetId === currentId,
                    );
                });

                const activeLink = document.querySelector(
                    `.toc-link[data-target="${currentId}"]`,
                );

                if (activeLink) {
                    activeLink.scrollIntoView({
                        behavior: "smooth",
                        block: "nearest",
                    });
                }
            }

            tocLinks.forEach((link) => {
                link.addEventListener("click", (event) => {
                    event.preventDefault();

                    const targetId = link.getAttribute("data-target");

                    if (!targetId) return;

                    const target = document.getElementById(targetId);

                    if (!target) return;

                    const top = target.offsetTop - offset;

                    window.scrollTo({
                        top,
                        behavior: "smooth",
                    });

                    history.replaceState(null, "", `#${targetId}`);
                });
            });

            window.addEventListener("scroll", updateActiveToc);
            window.addEventListener("resize", updateActiveToc);
            updateActiveToc();

            // =====================================
            // READING PROGRESS
            // =====================================

            const progressBar = document.getElementById("progressBar");

            window.addEventListener("scroll", () => {
                const scrollTop = window.scrollY;

                const documentHeight =
                    document.documentElement.scrollHeight - window.innerHeight;

                const progress =
                    documentHeight > 0 ? (scrollTop / documentHeight) * 100 : 0;

                if (progressBar) {
                    progressBar.style.width = `${progress}%`;
                }
            });

            // CODE BLOCK ENHANCEMENTS
            // =====================================

            const codeBlocks = document.querySelectorAll(".content pre");

            codeBlocks.forEach((pre) => {
                const code = pre.querySelector("code");

                if (!code) return;

                const preParent = pre.parentNode;
                const nextSibling = pre.nextSibling;

                if (!preParent) return;

                const languageMatch = code.className.match(/language-([a-z0-9]+)/i);
                const language = languageMatch ? languageMatch[1].toUpperCase() : "CODE";

                const container = document.createElement("div");
                container.className = "code-block-container";

                const header = document.createElement("div");
                header.className = "code-block-header";

                const langLabel = document.createElement("span");
                langLabel.className = "code-block-language";
                langLabel.textContent = language;

                const copyBtn = document.createElement("button");
                copyBtn.className = "copy-code-btn";
                copyBtn.type = "button";
                copyBtn.textContent = "Copy";

                header.append(langLabel, copyBtn);

                const body = document.createElement("div");
                body.className = "code-block-body";

                const lineNumbers = document.createElement("div");
                lineNumbers.className = "code-line-numbers";

                const rawLines = code.textContent.replace(/\t/g, "    ").split("\n");
                const lineCount = rawLines[rawLines.length - 1] === "" ? rawLines.length - 1 : rawLines.length;
                lineNumbers.innerHTML = Array.from({ length: Math.max(lineCount, 1) })
                    .map((_, index) => `<span>${index + 1}</span>`)
                    .join("");

                body.append(lineNumbers, pre);
                container.append(header, body);

                preParent.insertBefore(container, nextSibling || pre);

                copyBtn.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(code.innerText);
                        copyBtn.textContent = "Copied";

                        setTimeout(() => {
                            copyBtn.textContent = "Copy";
                        }, 1400);
                    } catch {
                        copyBtn.textContent = "Failed";
                    }
                });
            });
        </script>
    </body>
</html>

<style>
    /* =========================================
     RESET
  ========================================= */

    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        scroll-behavior: smooth;
        scroll-padding-top: 100px;
    }

    :global(body) {
        margin: 0;

        font-family:
            Inter,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;

        background: #f7f8fc;

        color: #202534;

        transition:
            background 0.25s ease,
            color 0.25s ease;

        overflow-x: hidden;
    }

    /* =========================================
     NAVBAR
  ========================================= */

    .navbar {
        height: 70px;

        padding: 0 5%;

        display: flex;

        align-items: center;

        justify-content: space-between;

        position: sticky;

        top: 0;

        z-index: 100;

        background: rgba(255, 255, 255, 0.92);

        backdrop-filter: blur(15px);

        border-bottom: 1px solid #e6e8ee;
    }

    .logo {
        color: #202534;

        text-decoration: none;

        font-size: 21px;

        font-weight: 800;
    }

    .logo span,
    .footer-logo span {
        color: #5b4bdb;
    }

    nav {
        display: flex;

        gap: 25px;
    }

    .navbar nav a {
        color: #687185;

        text-decoration: none;

        font-size: 14px;

        font-weight: 600;
    }

    .navbar nav a:hover {
        color: #5b4bdb;
    }

    .nav-actions {
        display: flex;

        align-items: center;

        gap: 10px;
    }

    .theme-btn {
        width: 40px;

        height: 40px;

        border-radius: 9px;

        border: 1px solid #dedfe8;

        background: white;

        cursor: pointer;

        font-size: 17px;
    }

    .back-btn {
        padding: 9px 15px;

        border-radius: 8px;

        border: 1px solid #dedfe8;

        background: white;

        color: #4d5668;

        text-decoration: none;

        font-size: 14px;

        font-weight: 600;
    }

    /* =========================================
     PAGE
  ========================================= */

    .page-wrapper {
        width: min(calc(100% - 40px), 1320px);

        margin: auto;

        padding: 35px 0 90px;
    }

    .breadcrumb {
        display: flex;

        gap: 9px;

        align-items: center;

