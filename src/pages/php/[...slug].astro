        margin: 20px 0 0;

        max-width: 800px;

        color: #6b7384;

        font-size: 17px;

        line-height: 1.7;
    }

    /* =========================================
     READING PROGRESS
  ========================================= */

    .reading-progress {
        height: 3px;

        background: #eeeef5;
    }

    #progressBar {
        width: 0%;

        height: 100%;

        background: #5b4bdb;

        transition: width 0.08s linear;
    }

    /* =========================================
     CONTENT
  ========================================= */

    .content {
        padding: 15px 60px 60px;

        font-size: 17px;

        line-height: 1.8;
    }

    .content :global(h1) {
        margin-top: 35px;

        font-size: 36px;

        line-height: 1.25;
    }

    .content :global(h2) {
        margin-top: 55px;

        margin-bottom: 18px;

        padding-top: 15px;

        font-size: 29px;

        line-height: 1.3;

        color: #202534;

        scroll-margin-top: 100px;
    }

    .content :global(h3) {
        margin-top: 38px;

        margin-bottom: 14px;

        font-size: 22px;

        line-height: 1.35;

        color: #30384a;

        scroll-margin-top: 100px;
    }

    .content :global(p) {
        margin: 18px 0;

        color: #4f586b;
    }

    .content :global(strong) {
        color: #202534;
    }

    .content :global(a) {
        color: #5b4bdb;
    }

    /* INLINE CODE */

    .content :global(code) {
        padding: 3px 7px;

        border-radius: 5px;

        background: #f1f1f5;

        color: #d14;

        font-size: 0.9em;
    }

    /* CODE BLOCK */

    .content :global(pre) {
        margin: 25px 0;

        padding: 22px;

        overflow-x: auto;

        border-radius: 12px;

        background: #181a20;

        color: #f1f2f5;

        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }

    .content :global(pre code) {
        padding: 0;

        background: transparent;

        color: inherit;

        font-size: 14px;

        line-height: 1.7;
    }

    :global(.code-block-container) {
        margin: 25px 0;
        max-width: 100%;
        border-radius: 16px;
        overflow: hidden;
        background: #0f1720;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
    }

    :global(.code-block-header) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 14px 18px;
        background: rgba(15, 23, 32, 0.96);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    :global(.code-block-language) {
        color: #8fbfe0;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
    }

    :global(.copy-code-btn) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border: none;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: #f8fafc;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    :global(.copy-code-btn:hover) {
        background: rgba(255, 255, 255, 0.16);
        transform: translateY(-1px);
    }

    :global(.code-block-body) {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        min-width: 0;
        overflow: hidden;
    }

    :global(.code-line-numbers) {
        padding: 22px 14px 22px 18px;
        text-align: right;
        user-select: none;
        color: rgba(255, 255, 255, 0.45);
        font-size: 12px;
        line-height: 1.7;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(15, 23, 32, 0.96);
    }

    :global(.code-line-numbers span) {
        display: block;
    }

    .content :global(pre) {
        margin: 0;
        min-width: 0;
        padding: 22px 18px;
        overflow-x: auto;
        background: transparent;
        box-shadow: none;
    }

    .content :global(pre code) {
        display: block;
        min-width: 100%;
    }

    /* TABLE */

    .content :global(table) {
        width: 100%;

        margin: 28px 0;

        border-collapse: collapse;

        overflow: hidden;

        border-radius: 10px;
    }

    .content :global(th),
    .content :global(td) {
        padding: 13px 15px;

        border: 1px solid #e1e3e9;

        text-align: left;
    }

    .content :global(th) {
        background: #f5f4ff;

        color: #35316c;

        font-weight: 700;
    }

    /* BLOCKQUOTE */

    .content :global(blockquote) {
        margin: 25px 0;

        padding: 15px 20px;

        border-left: 4px solid #5b4bdb;

        border-radius: 0 8px 8px 0;

        background: #f7f6ff;

        color: #555d70;
    }

    .content :global(ul),
    .content :global(ol) {
        padding-left: 28px;
    }

    .content :global(li) {
        margin: 7px 0;

        color: #4f586b;
    }

    /* =========================================
     TOC
  ========================================= */

    .toc-container {
        position: sticky;

        top: 100px;

        align-self: start;

        width: 100%;

        min-width: 0;

        max-height: calc(100vh - 120px);
    }

    .toc-card {
        width: 100%;

        padding: 20px;

        background: white;

        border: 1px solid #e5e7ed;

        border-radius: 14px;

        box-shadow: 0 8px 25px rgba(30, 35, 60, 0.04);

        position: relative;
    }

    .toc-card::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 14px;
        pointer-events: none;
        box-shadow: inset 0 0 0 1px rgba(91, 75, 219, 0.12);
    }

    .toc-title {
        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 12px;

        padding-bottom: 15px;

        margin-bottom: 8px;

        border-bottom: 1px solid #eceef3;
    }

    .toc-title > div {
        display: flex;

        align-items: center;

        gap: 9px;

        min-width: 0;
    }

    .toc-title strong {
        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;
    }

    .toc-icon {
        color: #5b4bdb;

        font-size: 16px;
    }

    .toc-count {
        min-width: 23px;

        height: 23px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 50%;

        background: #f0edff;

        color: #5b4bdb;

        font-size: 11px;

        font-weight: 700;
    }

    #toc {
        display: flex;

        flex-direction: column;

        gap: 2px;

        max-height: calc(100vh - 190px);

        overflow-y: auto;

        overflow-x: hidden;

        scrollbar-width: thin;
    }

    .toc-link {
        display: block;

        position: relative;

        padding: 8px 10px 8px 13px;

        margin: 2px 0;

        border-radius: 7px;

        color: #737b8d;

        text-decoration: none;

        font-size: 13px;

        line-height: 1.4;

        overflow-wrap: break-word;

        transition:
            color 0.2s ease,
            background 0.2s ease,
            padding-left 0.2s ease;
