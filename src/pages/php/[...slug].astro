        font-size: 13px;
    }

    .breadcrumb a {
        color: #656d7d;

        text-decoration: none;
    }

    .breadcrumb a:hover {
        color: #5b4bdb;
    }

    /* =========================================
     TWO COLUMN LAYOUT
  ========================================= */

    .layout {
        display: grid;

        grid-template-columns:
            minmax(0, 1fr)
            minmax(240px, 300px);

        gap: clamp(22px, 3vw, 36px);

        align-items: start;
    }

    /* =========================================
     ARTICLE
  ========================================= */

    .article {
        min-width: 0;

        background: white;

        border: 1px solid #e5e7ed;

        border-radius: 18px;

        overflow: hidden;

        box-shadow: 0 10px 35px rgba(30, 35, 60, 0.05);
    }

    .article-header {
        padding: 50px 60px 40px;
    }

    .article-meta {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 15px;

        margin-bottom: 18px;
    }

    .subject-badge {
        background: #f0edff;

        color: #5b4bdb;

        padding: 7px 13px;

        border-radius: 20px;

        font-size: 13px;

        font-weight: 700;
    }

    .author {
        color: #858c9b;

        font-size: 13px;
    }

    .article h1 {
        margin: 0;

