      .modal-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px; }
      body.dark { color: #e8eaf0; background: #101116; }
      body.dark .navbar, body.dark .sidebar { background: #17181e; border-color: #282a33; }
      body.dark .logo { color: #f0f1f5; }
      body.dark .toolbar, body.dark .table-container, body.dark .info-callout, body.dark .modal-card { background: #17181e; border-color: #282a33; color: #e8eaf0; }
      body.dark .search-box, body.dark .filter-group select, body.dark .modal-card input, body.dark .modal-card select { background: #101116; border-color: #282a33; color: #e8eaf0; }
      body.dark .data-table th { background: #20222a; color: #d1d5db; }
      body.dark .data-table td { border-color: #282a33; }
      body.dark .modal-card h3 { color: #f0f1f5; }
    </style>
