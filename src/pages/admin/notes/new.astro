---
import { getSupabaseConfig } from "../../../lib/supabase";
import { getGitHubConfig } from "../../../lib/github";

const config = getSupabaseConfig();
const githubConfig = getGitHubConfig();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Create New Note | Fahad Sir Admin</title>
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<!-- AUTH GUARD OVERLAY -->
		<div id="authGuardOverlay" class="auth-guard-overlay">
			<div class="auth-loader-card">
				<div class="spinner"></div>
				<p>Verifying Admin Security Credentials...</p>
			</div>
		</div>

		<!-- MAIN APP -->
		<div id="adminApp" class="admin-app hidden">
			<header class="navbar">
				<div class="brand-group">
					<a href="/admin" class="logo">
						Notes By <span>FSir</span>
					</a>
					<span class="admin-badge">⚡ Admin Portal / New Note</span>
				</div>

				<div class="nav-actions">
					<span class="admin-user-pill" id="adminUserPill">
						👤 Admin
					</span>

					<button
						id="themeToggle"
						class="theme-btn"
						aria-label="Toggle dark mode"
					>
						🌙
					</button>

					<a href="/admin" class="back-btn">
						← Back to Dashboard
					</a>
				</div>
			</header>

			<main class="editor-container">
				<div class="editor-header">
					<div>
						<h1>Create New Note</h1>
						<p>Add a new tutorial Markdown note to Notes By FSir.</p>
					</div>

					<div class="header-actions">
						<a href="/admin" class="secondary-btn">Cancel</a>
						<button id="saveNoteBtn" class="primary-btn">
							<span>💾 Save Note to GitHub</span>
						</button>
					</div>
				</div>

				{
					!githubConfig.isConfigured && (
						<div class="alert warning">
							<strong>⚙️ GitHub Integration Missing:</strong>
							<p>
								To save files to your GitHub repository, set <code>GITHUB_TOKEN</code>, <code>GITHUB_OWNER</code>, and <code>GITHUB_REPO</code> in your <code>.env.local</code> file or Vercel Environment Variables.
							</p>
						</div>
					)
				}

				<div id="statusAlert" class="alert hidden"></div>

				<form id="createNoteForm" class="note-form">
					<div class="meta-grid">
						<div class="form-group">
							<label for="title">Note Title</label>
							<input
								type="text"
								id="title"
								name="title"
								placeholder="e.g. 2.6 File Handling in PHP"
								required
							/>
						</div>

						<div class="form-group">
							<label for="chapter">Chapter Number / ID</label>
							<input
								type="text"
								id="chapter"
								name="chapter"
								placeholder="e.g. 2.6"
								required
							/>
						</div>

						<div class="form-group">
							<label for="subject">Subject</label>
							<select id="subject" name="subject" required>
								<option value="PHP">PHP 🐘</option>
								<option value="Python">Python 🐍</option>
								<option value="Java">Java ☕</option>
								<option value="C++">C++ 💻</option>
								<option value="C">C ⚙️</option>
								<option value="MySQL">MySQL 🗄️</option>
								<option value="DSA">DSA 🌳</option>
								<option value="HTML">HTML 🌐</option>
								<option value="CSS">CSS 🎨</option>
								<option value="JavaScript">JavaScript ⚡</option>
							</select>
						</div>

						<div class="form-group">
							<label for="author">Author Name</label>
							<input
								type="text"
								id="author"
								name="author"
								value="Fahad Sir"
								required
							/>
						</div>

						<div class="form-group full-width">
							<label for="description">Short Description</label>
							<input
								type="text"
								id="description"
								name="description"
								placeholder="Brief summary of note topic for preview cards"
								required
							/>
						</div>

						<div class="form-group full-width">
							<label for="filename">Markdown Filename (Auto-generated)</label>
							<input
								type="text"
								id="filename"
								name="filename"
								placeholder="file-handling.md"
								required
							/>
							<small class="help-text">Saved in <code>src/content/[subject]/[filename]</code></small>
						</div>
					</div>

					<!-- SPLIT EDITOR / PREVIEW -->
					<div class="editor-split">
						<div class="editor-pane">
							<div class="pane-header">
								<span>📝 Markdown Editor</span>
							</div>
							<textarea
								id="markdownContent"
								name="content"
								placeholder="# Enter your Markdown tutorial content here...

PHP provides built-in functions for file and directory handling..."
								required
							></textarea>
						</div>

						<div class="preview-pane">
							<div class="pane-header" style="display: flex; justify-content: space-between; align-items: center;">
								<span>👁️ Live Preview</span>
								<button type="button" id="openFullPreviewBtn" style="padding: 4px 10px; font-size: 12px; cursor: pointer; border-radius: 6px; background: #4f46e5; color: #ffffff; border: none; font-weight: 600; display: flex; align-items: center; gap: 4px;">
									↗ Open Full Page in New Tab
								</button>
							</div>
							<div id="markdownPreview" class="preview-content">
								<p class="text-muted">Start typing Markdown content on the left to see live preview...</p>
							</div>
						</div>
					</div>
				</form>
			</main>
		</div>

		<!-- CLIENT SCRIPT -->
		<script is:inline define:vars={{ supabaseUrl: config.url, supabaseKey: config.anonKey, isConfigured: config.isConfigured }}>
			// Theme Toggle
			const themeButton = document.getElementById("themeToggle");
			const savedTheme = localStorage.getItem("theme");

			if (savedTheme === "dark") {
				document.body.classList.add("dark");
				if (themeButton) themeButton.textContent = "☀️";
			}

			themeButton?.addEventListener("click", () => {
				document.body.classList.toggle("dark");
				const isDark = document.body.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
				themeButton.textContent = isDark ? "☀️" : "🌙";
			});

			let supabase = null;
			let sessionToken = null;

			// Auth Guard
			async function initAuth() {
				const overlay = document.getElementById("authGuardOverlay");
				const app = document.getElementById("adminApp");

				if (!isConfigured || !supabaseUrl || !supabaseKey) {
					window.location.href = "/login";
					return;
				}

				try {
					const mod = await import("https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm");
					supabase = mod.createClient(supabaseUrl, supabaseKey);

					const secretPass = localStorage.getItem("admin_secret_pass");
					const isSecretAdmin = secretPass === "324232";
					let displayEmail = "fahadvohra143@gmail.com (Secret Admin)";

					if (!isSecretAdmin) {
						const { data: { session } } = await supabase.auth.getSession();
						if (!session) {
							window.location.href = "/login";
							return;
						}

						sessionToken = session.access_token;

						const { data: profile } = await supabase
							.from("profiles")
							.select("role, email")
							.eq("id", session.user.id)
							.single();

						if (!profile || profile.role?.trim().toLowerCase() !== "admin") {
							alert("Unauthorized: Admin access required.");
							window.location.href = "/login";
							return;
						}
						displayEmail = profile.email || session.user.email;
					}

					const adminPill = document.getElementById("adminUserPill");
					if (adminPill) adminPill.textContent = `👑 ${displayEmail}`;

					overlay?.classList.add("hidden");
					app?.classList.remove("hidden");

				} catch (err) {
					console.error("Auth initialization error:", err);
					window.location.href = "/login";
				}
			}

			initAuth();

			// Auto Filename Generator
			const titleInput = document.getElementById("title");
			const filenameInput = document.getElementById("filename");

			titleInput?.addEventListener("input", () => {
				if (!filenameInput.dataset.userEdited) {
					let val = titleInput.value.toLowerCase().trim();
					// Remove chapter numbers e.g. "2.6 "
					val = val.replace(/^[0-9.]+\s*/, "");
					// Convert to slug
					const slug = val
						.replace(/[^a-z0-9\s-]/g, "")
						.replace(/\s+/g, "-")
						.replace(/-+/g, "-");

					filenameInput.value = slug ? `${slug}.md` : "";
				}
			});

			filenameInput?.addEventListener("input", () => {
				filenameInput.dataset.userEdited = "true";
			});

			// Live Markdown Preview Logic
			const markdownInput = document.getElementById("markdownContent");
			const markdownPreview = document.getElementById("markdownPreview");

			function renderPreview() {
				if (!markdownPreview || !markdownInput) return;
				const text = markdownInput.value;
				if (!text.trim()) {
					markdownPreview.innerHTML = '<p class="text-muted">Start typing Markdown content on the left to see live preview...</p>';
					return;
				}

				// Simple fast markdown parser for preview
				let html = text
					.replace(/^### (.*$)/gim, '<h3>$1</h3>')
					.replace(/^## (.*$)/gim, '<h2>$1</h2>')
					.replace(/^# (.*$)/gim, '<h1>$1</h1>')
					.replace(/\*\*(.*)\*\*/gim, '<strong>$1</strong>')
					.replace(/\*(.*)\*/gim, '<em>$1</em>')
					.replace(/`([^`]+)`/gim, '<code>$1</code>')
					.replace(/```([a-z]*)\n([\s\S]*?)\n```/gim, '<pre><code>$2</code></pre>')
					.replace(/^\* (.*$)/gim, '<li>$1</li>')
					.replace(/\n\n/gim, '<br/><br/>');

				markdownPreview.innerHTML = html;
			}

			markdownInput?.addEventListener("input", renderPreview);

			// Open Full Page Preview in New Tab
			const openFullPreviewBtn = document.getElementById("openFullPreviewBtn");
			openFullPreviewBtn?.addEventListener("click", () => {
				const title = document.getElementById("title")?.value || "Live Note Preview";
				const subject = document.getElementById("subject")?.value || "PHP";
				const chapter = document.getElementById("chapter")?.value || "";
				const previewHtml = document.getElementById("markdownPreview")?.innerHTML || "";

				const newTab = window.open("", "_blank");
				if (newTab) {
					newTab.document.write(`
						<!DOCTYPE html>
						<html lang="en">
						<head>
							<meta charset="UTF-8">
							<meta name="viewport" content="width=device-width, initial-scale=1.0">
							<title>${title} | Full Page Preview - Notes By FSir</title>
							<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/github-markdown-css@5/github-markdown.min.css">
							<style>
								body {
									font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
									background: #f8fafc;
									color: #0f172a;
									margin: 0;
									padding: 0;
								}
								header {
									background: #1e293b;
									color: #ffffff;
									padding: 28px 36px;
									box-shadow: 0 4px 14px rgba(0,0,0,0.12);
								}
								.badge {
									display: inline-block;
									background: #6366f1;
									color: #fff;
									padding: 4px 12px;
									border-radius: 20px;
									font-size: 12px;
									font-weight: 600;
									text-transform: uppercase;
									margin-bottom: 10px;
								}
								h1 { margin: 0 0 6px 0; font-size: 32px; font-weight: 700; }
								.chapter-name { color: #94a3b8; font-size: 15px; margin: 0; }
								main {
									max-width: 920px;
									margin: 36px auto;
									background: #ffffff;
									padding: 48px;
									border-radius: 14px;
									box-shadow: 0 4px 24px rgba(0,0,0,0.06);
									border: 1px solid #e2e8f0;
								}
								.markdown-body {
									font-size: 16px;
									line-height: 1.8;
								}
								pre {
									background: #0f172a !important;
									color: #f8fafc !important;
									padding: 18px;
									border-radius: 10px;
									overflow-x: auto;
								}
								code {
									font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
								}
							</style>
						</head>
						<body>
							<header>
								<span class="badge">📚 ${subject} Tutorial Preview</span>
								<h1>${title}</h1>
								${chapter ? `<p class="chapter-name">📌 Chapter: ${chapter}</p>` : ''}
							</header>
							<main class="markdown-body">
								${previewHtml || '<p style="color:#64748b;">No content entered yet.</p>'}
							</main>
						</body>
						</html>
					`);
					newTab.document.close();
				}
			});

			// Form Save Handler
			const saveNoteBtn = document.getElementById("saveNoteBtn");
			const statusAlert = document.getElementById("statusAlert");

			saveNoteBtn?.addEventListener("click", async (e) => {
				e.preventDefault();

				const title = document.getElementById("title").value.trim();
				const chapter = document.getElementById("chapter").value.trim();
				const subject = document.getElementById("subject").value;
				const author = document.getElementById("author").value.trim();
				const description = document.getElementById("description").value.trim();
				const filename = document.getElementById("filename").value.trim();
				const body = document.getElementById("markdownContent").value;

				if (!title || !chapter || !filename || !description) {
					alert("Please fill in all required fields (Title, Chapter, Subject, Description, Filename).");
					return;
				}

				if (saveNoteBtn) saveNoteBtn.disabled = true;
				statusAlert?.classList.add("hidden");

				try {
					const res = await fetch("/api/notes/save", {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							"Authorization": `Bearer ${sessionToken}`,
							"x-admin-secret": localStorage.getItem("admin_secret_pass") || "",
						},
						body: JSON.stringify({
							filename,
							title,
							description,
							subject,
							chapter,
							author,
							body,
						}),
					});

					const data = await res.json();

					if (!res.ok) {
						throw new Error(data.error || "Failed to save note.");
					}

					if (statusAlert) {
						statusAlert.className = "alert success";
						statusAlert.innerHTML = `
							<strong>🎉 Note Saved Successfully!</strong>
							<p>${data.message}</p>
							<p><small>Git File Path: <code>${data.filePath}</code></small></p>
						`;
						statusAlert.classList.remove("hidden");
					}

					setTimeout(() => {
						window.location.href = "/admin";
					}, 2500);

				} catch (err) {
					if (statusAlert) {
						statusAlert.className = "alert danger";
						statusAlert.innerHTML = `<strong>Error:</strong> ${err.message}`;
						statusAlert.classList.remove("hidden");
					}
				} finally {
					if (saveNoteBtn) saveNoteBtn.disabled = false;
				}
			});
		</script>

		<!-- STYLES -->
		<style>
			:global(*) {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			:global(body) {
				font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: #172033;
				background: #f7f9fc;
				transition: background 0.25s ease, color 0.25s ease;
				min-height: 100vh;
			}

			.hidden { display: none !important; }

			.auth-guard-overlay {
				position: fixed;
				inset: 0;
				background: #ffffff;
				z-index: 999;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.auth-loader-card {
				text-align: center;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 16px;
			}

			.spinner {
				width: 44px;
				height: 44px;
				border: 4px solid #e0e4f0;
				border-top-color: #5b4bdb;
				border-radius: 50%;
				animation: spin 0.8s linear infinite;
			}

			@keyframes spin { to { transform: rotate(360deg); } }

			.navbar {
				height: 70px;
				padding: 0 4%;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid #e9ebf1;
				background: #ffffff;
				position: sticky;
				top: 0;
				z-index: 100;
			}

			.brand-group {
				display: flex;
				align-items: center;
				gap: 14px;
			}

			.logo {
				color: #172033;
				text-decoration: none;
				font-size: 22px;
				font-weight: 800;
			}

			.logo span { color: #5b4bdb; }

			.admin-badge {
				background: #f2efff;
				border: 1px solid #e6e2ff;
				color: #5b4bdb;
				padding: 4px 10px;
				border-radius: 20px;
				font-size: 12px;
				font-weight: 700;
			}

			.nav-actions {
				display: flex;
				align-items: center;
				gap: 14px;
			}

			.admin-user-pill {
				font-size: 14px;
				font-weight: 600;
				color: #4b5563;
				background: #f3f4f6;
				padding: 6px 12px;
				border-radius: 8px;
			}

			.theme-btn, .back-btn, .secondary-btn {
				border: 1px solid #dddff0;
				background: white;
				cursor: pointer;
				font-weight: 600;
				font-size: 14px;
				color: #172033;
				border-radius: 8px;
				text-decoration: none;
			}

			.theme-btn {
				width: 38px;
				height: 38px;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.back-btn, .secondary-btn {
				padding: 8px 16px;
			}

			.editor-container {
				max-width: 1300px;
				margin: 30px auto;
				padding: 0 20px 60px;
			}

			.editor-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 24px;
			}

			.editor-header h1 {
				font-size: 26px;
				font-weight: 800;
				color: #172033;
			}

			.editor-header p {
				color: #6b7280;
				font-size: 14px;
			}

			.header-actions {
				display: flex;
				gap: 12px;
			}

			.primary-btn {
				background: #5b4bdb;
				color: white;
				padding: 10px 20px;
				border-radius: 10px;
				border: none;
				font-size: 15px;
				font-weight: 700;
				cursor: pointer;
			}

			.primary-btn:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}

			.alert {
				padding: 16px 20px;
				border-radius: 12px;
				font-size: 14px;
				margin-bottom: 24px;
				line-height: 1.5;
			}

			.alert.warning { background: #fff8e6; border: 1px solid #ffe8b3; color: #8a6d3b; }
			.alert.danger { background: #fdf2f2; border: 1px solid #f8b4b4; color: #9b1c1c; }
			.alert.success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
			.alert code { background: rgba(0,0,0,0.06); padding: 2px 6px; border-radius: 4px; }

			.note-form {
				display: flex;
				flex-direction: column;
				gap: 24px;
			}

			.meta-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 20px;
				background: #ffffff;
				border: 1px solid #e5e7eb;
				border-radius: 16px;
				padding: 24px;
			}

			.form-group {
				display: flex;
				flex-direction: column;
				gap: 6px;
			}

			.form-group.full-width {
				grid-column: span 2;
			}

			.form-group label {
				font-size: 13px;
				font-weight: 700;
				color: #374151;
			}

			.form-group input, .form-group select {
				padding: 10px 14px;
				border-radius: 8px;
				border: 1px solid #d1d5db;
				font-size: 14px;
				outline: none;
			}

			.help-text {
				font-size: 12px;
				color: #6b7280;
			}

			.editor-split {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 20px;
				min-height: 500px;
			}

			.editor-pane, .preview-pane {
				background: #ffffff;
				border: 1px solid #e5e7eb;
				border-radius: 16px;
				display: flex;
				flex-direction: column;
				overflow: hidden;
			}

			.pane-header {
				padding: 12px 18px;
				background: #f9fafb;
				border-bottom: 1px solid #e5e7eb;
				font-size: 13px;
				font-weight: 700;
				color: #374151;
			}

			#markdownContent {
				flex: 1;
				padding: 20px;
				border: none;
				outline: none;
				font-family: monospace, monospace;
				font-size: 14px;
				line-height: 1.6;
				resize: vertical;
				min-height: 450px;
			}

			.preview-content {
				flex: 1;
				padding: 20px;
				overflow-y: auto;
				font-size: 15px;
				line-height: 1.7;
			}

			.preview-content h1 { font-size: 26px; margin-bottom: 12px; }
			.preview-content h2 { font-size: 22px; margin: 16px 0 10px; }
			.preview-content h3 { font-size: 18px; margin: 14px 0 8px; }
			.preview-content code { background: #f3f4f6; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
			.preview-content pre { background: #1e1e1e; color: #d4d4d4; padding: 14px; border-radius: 8px; overflow-x: auto; }

			.text-muted { color: #9ca3af; font-style: italic; }

			/* DARK MODE */
			body.dark { color: #e8eaf0; background: #101116; }
			body.dark .auth-guard-overlay { background: #101116; color: #e8eaf0; }
			body.dark .navbar { background: #17181e; border-color: #282a33; }
			body.dark .logo { color: #f0f1f5; }
			body.dark .editor-header h1 { color: #f0f1f5; }
