---
import { getSupabaseConfig } from "../../../lib/supabase";

const config = getSupabaseConfig();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>User Management | Fahad Sir Admin</title>
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<!-- AUTH GUARD OVERLAY -->
		<div id="authGuardOverlay" class="auth-guard-overlay">
			<div class="auth-loader-card">
				<div class="spinner"></div>
				<p>Verifying Admin Security Credentials...</p>
			</div>
		</div>

		<!-- MAIN ADMIN APP -->
		<div id="adminApp" class="admin-app hidden">
			<!-- NAVBAR -->
			<header class="navbar">
				<div class="brand-group">
					<a href="/admin" class="logo">
						Notes By <span>FSir</span>
					</a>
					<span class="admin-badge">👥 User Management</span>
				</div>

				<div class="nav-actions">
					<span class="admin-user-pill" id="adminUserPill">
						👤 Loading...
					</span>

					<button
						id="themeToggle"
						class="theme-btn"
						aria-label="Toggle dark mode"
					>
						🌙
					</button>

					<button id="logoutBtn" class="logout-btn">
						Logout
					</button>
				</div>
			</header>

			<!-- ADMIN CONTAINER -->
			<div class="admin-layout">
				<!-- SIDEBAR NAVIGATION -->
				<aside class="sidebar">
					<div class="user-greeting">
						<h2>Fahad Sir Admin</h2>
						<p>System Administrator</p>
					</div>

					<nav class="sidebar-nav">
						<a href="/admin" class="nav-item">
							<span>📊</span> Overview Dashboard
						</a>
						<a href="/admin/users" class="nav-item active">
							<span>👥</span> User Management
						</a>
					</nav>

					<div class="sidebar-footer">
						<a href="/" class="site-link">← View Public Website</a>
					</div>
				</aside>

				<!-- MAIN CONTENT AREA -->
				<main class="admin-main">
					<div class="page-header flex-header">
						<div>
							<h1>User Management</h1>
							<p>View registered accounts, verify status, and manage active/blocked access.</p>
						</div>

						<div class="header-stats">
							<span class="stat-badge">Total Users: <strong id="totalUsersCount">0</strong></span>
							<span class="stat-badge danger">Blocked: <strong id="blockedUsersCount">0</strong></span>
						</div>
					</div>

					<div id="statusAlert" class="alert hidden"></div>

					<!-- SEARCH AND FILTER TOOLBAR -->
					<div class="toolbar">
						<div class="search-box">
							<span class="search-icon">🔍</span>
							<input
								type="text"
								id="searchInput"
								placeholder="Search users by name or email..."
							/>
						</div>

						<div class="filter-group">
							<label for="statusFilter">Status:</label>
							<select id="statusFilter">
								<option value="all">All Statuses</option>
								<option value="active">Active Only</option>
								<option value="blocked">Blocked Only</option>
							</select>
						</div>
					</div>

					<!-- USERS DATA TABLE -->
					<div class="table-container">
						<div id="loadingState" class="loading-state">
							<div class="spinner small"></div>
							<p>Fetching user directory from database...</p>
						</div>

						<table id="usersTable" class="data-table hidden">
							<thead>
								<tr>
									<th>Full Name</th>
									<th>Email Address</th>
									<th>Role</th>
									<th>Account Status</th>
									<th>Joined Date</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody id="usersTbody">
								<!-- Populated dynamically via JS -->
							</tbody>
						</table>

						<div id="emptyState" class="empty-state hidden">
							<p>🔍 No users found matching your search filter.</p>
						</div>
					</div>
				</main>
			</div>
		</div>

		<!-- BLOCK / UNBLOCK CONFIRMATION MODAL -->
		<div id="confirmModal" class="modal-backdrop hidden">
			<div class="modal-card">
				<div class="modal-header">
					<h3 id="confirmModalTitle">Confirm Action</h3>
					<button class="close-modal-btn" id="closeModalBtn">&times;</button>
				</div>
				<div class="modal-body">
					<p id="confirmModalText">Are you sure you want to perform this action?</p>
				</div>
				<div class="modal-actions">
					<button type="button" class="secondary-btn" id="cancelModalBtn">Cancel</button>
					<button type="button" class="primary-btn" id="executeActionBtn">Confirm</button>
				</div>
			</div>
		</div>

		<!-- CLIENT ADMIN SCRIPT -->
		<script is:inline define:vars={{ supabaseUrl: config.url, supabaseKey: config.anonKey, isConfigured: config.isConfigured }}>
			// Theme Toggle
			const themeButton = document.getElementById("themeToggle");
			const savedTheme = localStorage.getItem("theme");

			if (savedTheme === "dark") {
				document.body.classList.add("dark");
				if (themeButton) themeButton.textContent = "☀️";
			}

			themeButton?.addEventListener("click", () => {
				document.body.classList.toggle("dark");
				const isDark = document.body.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
				themeButton.textContent = isDark ? "☀️" : "🌙";
			});

			let supabase = null;
			let sessionToken = null;
			let currentAdminUser = null;
			let allUsers = [];

			// Auth Guard Logic
			async function initAdminGuard() {
				const overlay = document.getElementById("authGuardOverlay");
				const app = document.getElementById("adminApp");

				if (!isConfigured || !supabaseUrl || !supabaseKey) {
					alert("Supabase credentials not configured in .env.local! Redirecting to Login.");
					window.location.href = "/login";
					return;
				}

				try {
					const mod = await import("https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm");
					supabase = mod.createClient(supabaseUrl, supabaseKey);

					const { data: { session } } = await supabase.auth.getSession();

					if (!session) {
						window.location.href = "/login";
						return;
					}

					sessionToken = session.access_token;
					currentAdminUser = session.user;

					// Verify Role & Block Status
					const { data: profile, error } = await supabase
						.from("profiles")
						.select("role, email, is_blocked")
						.eq("id", session.user.id)
						.single();

					if (profile?.is_blocked) {
						await supabase.auth.signOut();
						alert("Account Blocked: Access denied.");
						window.location.href = "/login";
						return;
					}

					if (error || !profile || profile.role?.trim().toLowerCase() !== "admin") {
						alert("Unauthorized Access: Only authenticated ADMIN users can access this page.");
						window.location.href = "/login";
						return;
					}

					const displayEmail = profile.email || session.user.email;
					const adminPill = document.getElementById("adminUserPill");
					if (adminPill) adminPill.textContent = `👑 ${displayEmail}`;

					// Grant Access
					overlay?.classList.add("hidden");
					app?.classList.remove("hidden");

					// Fetch Users Directory
					fetchUsersList();

				} catch (err) {
					console.error("Auth guard error:", err);
					window.location.href = "/login";
				}
			}

			initAdminGuard();

			// Logout Handler
			document.getElementById("logoutBtn")?.addEventListener("click", async () => {
				if (supabase) {
					await supabase.auth.signOut();
				}
				window.location.href = "/login";
			});

			// Fetch Users via Server API Endpoint
			async function fetchUsersList() {
				const loadingState = document.getElementById("loadingState");

				try {
					const res = await fetch("/api/admin/users/list", {
						headers: {
							"Authorization": `Bearer ${sessionToken}`,
						},
					});

					const data = await res.json();

					if (!res.ok) {
						throw new Error(data.error || "Failed to fetch user directory.");
					}

					allUsers = data.users || [];
					renderUsers();

				} catch (err) {
					showAlert(err.message, "danger");
				} finally {
					loadingState?.classList.add("hidden");
				}
			}

			// Render Users Table with Filter
			function renderUsers() {
				const tbody = document.getElementById("usersTbody");
				const usersTable = document.getElementById("usersTable");
				const emptyState = document.getElementById("emptyState");
				const totalCount = document.getElementById("totalUsersCount");
				const blockedCount = document.getElementById("blockedUsersCount");

				const searchQuery = document.getElementById("searchInput")?.value.toLowerCase().trim() || "";
				const statusFilter = document.getElementById("statusFilter")?.value || "all";

				const filtered = allUsers.filter(u => {
					const matchSearch = (u.full_name || "").toLowerCase().includes(searchQuery) || (u.email || "").toLowerCase().includes(searchQuery);
					const matchStatus = statusFilter === "all" ? true : statusFilter === "blocked" ? u.is_blocked : !u.is_blocked;
					return matchSearch && matchStatus;
				});

				if (totalCount) totalCount.textContent = allUsers.length;
				if (blockedCount) blockedCount.textContent = allUsers.filter(u => u.is_blocked).length;

				if (filtered.length === 0) {
					usersTable?.classList.add("hidden");
					emptyState?.classList.remove("hidden");
					return;
				}

				emptyState?.classList.add("hidden");
				usersTable?.classList.remove("hidden");

				if (tbody) {
					tbody.innerHTML = filtered.map(u => {
						const isSelf = u.id === currentAdminUser?.id;
						const createdDate = u.created_at ? new Date(u.created_at).toLocaleDateString() : "N/A";
						const fullName = escapeHtml(u.full_name || "Student User");
						const roleStr = (u.role || "student").toUpperCase();

						return `
							<tr>
								<td><strong>${fullName}</strong> ${isSelf ? '<span class="self-badge">(You)</span>' : ''}</td>
								<td><code>${escapeHtml(u.email)}</code></td>
								<td><span class="role-pill ${roleStr.toLowerCase()}">${roleStr}</span></td>
								<td>
									<span class="status-pill ${u.is_blocked ? 'blocked' : 'active'}">
										${u.is_blocked ? '🔴 BLOCKED' : '🟢 ACTIVE'}
									</span>
								</td>
								<td>${createdDate}</td>
								<td class="actions-cell">
									${isSelf ? '<span class="text-muted">No Action</span>' : `
										<button class="action-btn ${u.is_blocked ? 'success' : 'danger'} toggle-block-btn" data-id="${u.id}" data-name="${fullName}" data-blocked="${u.is_blocked ? 'true' : 'false'}">
											${u.is_blocked ? '✅ Unblock' : '🚫 Block'}
										</button>
									`}
								</td>
							</tr>
						`;
					}).join('');

					// Attach Action Listeners
					document.querySelectorAll(".toggle-block-btn").forEach(btn => {
						btn.addEventListener("click", () => {
							const targetId = btn.getAttribute("data-id");
							const targetName = btn.getAttribute("data-name");
							const isCurrentlyBlocked = btn.getAttribute("data-blocked") === "true";
							promptBlockConfirmation(targetId, targetName, !isCurrentlyBlocked);
						});
					});
				}
			}

			// Filter Event Listeners
			document.getElementById("searchInput")?.addEventListener("input", renderUsers);
			document.getElementById("statusFilter")?.addEventListener("change", renderUsers);

			// Confirmation Modal Handling
			const confirmModal = document.getElementById("confirmModal");
			const closeModalBtn = document.getElementById("closeModalBtn");
			const cancelModalBtn = document.getElementById("cancelModalBtn");
			const executeActionBtn = document.getElementById("executeActionBtn");
			const confirmModalTitle = document.getElementById("confirmModalTitle");
			const confirmModalText = document.getElementById("confirmModalText");

			let pendingAction = null;

			function promptBlockConfirmation(userId, userName, setBlocked) {
				if (!confirmModal || !confirmModalTitle || !confirmModalText) return;

				confirmModalTitle.textContent = setBlocked ? "Confirm Block User" : "Confirm Unblock User";
				confirmModalText.innerHTML = `Are you sure you want to <strong>${setBlocked ? "BLOCK" : "UNBLOCK"}</strong> user <strong>${userName}</strong>?<br/><br/><small class="text-muted">${setBlocked ? 'Blocked users will not be able to log in or access admin services.' : 'Unblocked users will regain login access.'}</small>`;

				if (executeActionBtn) {
					executeActionBtn.className = setBlocked ? "primary-btn danger" : "primary-btn success";
					executeActionBtn.textContent = setBlocked ? "Block User" : "Unblock User";
				}

				pendingAction = { userId, setBlocked };
				confirmModal.classList.remove("hidden");
			}

			closeModalBtn?.addEventListener("click", () => confirmModal?.classList.add("hidden"));
			cancelModalBtn?.addEventListener("click", () => confirmModal?.classList.add("hidden"));

			executeActionBtn?.addEventListener("click", async () => {
				if (!pendingAction) return;
				const { userId, setBlocked } = pendingAction;
				confirmModal?.classList.add("hidden");

				if (executeActionBtn) executeActionBtn.disabled = true;

				try {
					const res = await fetch("/api/admin/users/toggle-block", {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							"Authorization": `Bearer ${sessionToken}`,
						},
						body: JSON.stringify({
							userId,
							is_blocked: setBlocked,
						}),
					});

					const data = await res.json();

					if (!res.ok) {
						throw new Error(data.error || "Failed to update block status.");
					}

					showAlert(data.message, "success");
					fetchUsersList();

				} catch (err) {
					showAlert("Error: " + err.message, "danger");
				} finally {
					if (executeActionBtn) executeActionBtn.disabled = false;
					pendingAction = null;
				}
			});

			function showAlert(msg, type) {
				const statusAlert = document.getElementById("statusAlert");
				if (statusAlert) {
					statusAlert.className = `alert ${type}`;
					statusAlert.innerHTML = msg;
					statusAlert.classList.remove("hidden");
					setTimeout(() => statusAlert.classList.add("hidden"), 4000);
				}
			}

			function escapeHtml(str) {
				return str ? str.replace(/[&<>"']/g, function(m) {
					return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
				}) : '';
			}
		</script>

		<!-- STYLES -->
		<style>
			:global(*) { box-sizing: border-box; margin: 0; padding: 0; }
			:global(body) {
				font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: #172033;
				background: #f7f9fc;
				transition: background 0.25s ease, color 0.25s ease;
				min-height: 100vh;
			}
			.hidden { display: none !important; }
			.auth-guard-overlay {
				position: fixed; inset: 0; background: #ffffff; z-index: 999;
				display: flex; align-items: center; justify-content: center;
			}
			.auth-loader-card { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; }
			.spinner {
				width: 44px; height: 44px; border: 4px solid #e0e4f0;
				border-top-color: #5b4bdb; border-radius: 50%; animation: spin 0.8s linear infinite;
			}
			.spinner.small { width: 24px; height: 24px; border-width: 3px; }
			@keyframes spin { to { transform: rotate(360deg); } }

			.navbar {
				height: 70px; padding: 0 4%; display: flex; align-items: center; justify-content: space-between;
				border-bottom: 1px solid #e9ebf1; background: #ffffff; position: sticky; top: 0; z-index: 100;
			}
			.brand-group { display: flex; align-items: center; gap: 14px; }
			.logo { color: #172033; text-decoration: none; font-size: 22px; font-weight: 800; }
			.logo span { color: #5b4bdb; }
			.admin-badge {
				background: #f2efff; border: 1px solid #e6e2ff; color: #5b4bdb;
				padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 700;
			}
			.nav-actions { display: flex; align-items: center; gap: 14px; }
			.admin-user-pill { font-size: 14px; font-weight: 600; color: #4b5563; background: #f3f4f6; padding: 6px 12px; border-radius: 8px; }
			.theme-btn, .logout-btn { border: 1px solid #dddff0; background: white; cursor: pointer; font-weight: 600; font-size: 14px; color: #172033; border-radius: 8px; }
			.theme-btn { width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; }
			.logout-btn { padding: 8px 16px; background: #fee2e2; color: #dc2626; border-color: #fca5a5; }

			.admin-layout { display: grid; grid-template-columns: 260px 1fr; min-height: calc(100vh - 70px); }
			.sidebar { background: #ffffff; border-right: 1px solid #e9ebf1; padding: 30px 20px; display: flex; flex-direction: column; justify-content: space-between; }
			.user-greeting { margin-bottom: 24px; }
			.user-greeting h2 { font-size: 18px; font-weight: 700; color: #172033; }
			.user-greeting p { font-size: 13px; color: #6b7280; }
			.sidebar-nav { display: flex; flex-direction: column; gap: 8px; }
			.sidebar-nav .nav-item {
				display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 10px;
				border: none; background: transparent; color: #4b5563; font-size: 14px; font-weight: 600; text-decoration: none;
			}
			.sidebar-nav .nav-item:hover, .sidebar-nav .nav-item.active { background: #f3f0ff; color: #5b4bdb; }
			.sidebar-footer { border-top: 1px solid #e9ebf1; padding-top: 16px; }
			.site-link { color: #6b7280; text-decoration: none; font-size: 13px; font-weight: 600; }

			.admin-main { padding: 30px 40px; }
			.flex-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
			.page-header h1 { font-size: 26px; font-weight: 800; color: #172033; }
			.page-header p { font-size: 14px; color: #6b7280; }
			.header-stats { display: flex; gap: 12px; }
			.stat-badge { background: #ffffff; border: 1px solid #e5e7eb; padding: 8px 14px; border-radius: 8px; font-size: 13px; color: #4b5563; }
			.stat-badge.danger { background: #fef2f2; border-color: #fca5a5; color: #991b1b; }

			.alert { padding: 14px 18px; border-radius: 10px; font-size: 14px; margin-bottom: 20px; }
			.alert.danger { background: #fdf2f2; border: 1px solid #f8b4b4; color: #9b1c1c; }
			.alert.success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }

			.toolbar { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 20px; background: #ffffff; padding: 16px 20px; border-radius: 12px; border: 1px solid #e5e7eb; }
			.search-box { display: flex; align-items: center; gap: 8px; flex: 1; max-width: 400px; background: #f9fafb; border: 1px solid #d1d5db; padding: 8px 12px; border-radius: 8px; }
			.search-box input { border: none; background: transparent; outline: none; width: 100%; font-size: 14px; }
			.filter-group { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #4b5563; }
			.filter-group select { padding: 8px 12px; border-radius: 8px; border: 1px solid #d1d5db; font-size: 14px; outline: none; }

			.table-container { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 16px; overflow: hidden; }
			.loading-state, .empty-state { padding: 40px; text-align: center; color: #6b7280; display: flex; flex-direction: column; align-items: center; gap: 12px; }

			.data-table { width: 100%; border-collapse: collapse; text-align: left; }
			.data-table th, .data-table td { padding: 14px 20px; border-bottom: 1px solid #e5e7eb; font-size: 14px; }
			.data-table th { background: #f9fafb; font-weight: 700; color: #374151; font-size: 13px; }
			.self-badge { background: #e0e7ff; color: #3730a3; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 700; margin-left: 6px; }
			.role-pill { padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; }
			.role-pill.admin { background: #fef3c7; color: #92400e; }
			.role-pill.student { background: #f3f4f6; color: #4b5563; }
			.status-pill { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 700; }
			.status-pill.active { background: #dcfce7; color: #166534; }
			.status-pill.blocked { background: #fee2e2; color: #991b1b; }
			.action-btn { padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; }
			.action-btn.danger { background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; }
			.action-btn.success { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }
			.text-muted { color: #9ca3af; font-size: 13px; }

			.modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 999; display: flex; align-items: center; justify-content: center; padding: 20px; }
			.modal-card { width: 100%; max-width: 440px; background: #ffffff; border-radius: 16px; padding: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.15); }
			.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
			.modal-header h3 { font-size: 18px; font-weight: 700; color: #172033; }
			.close-modal-btn { background: none; border: none; font-size: 22px; cursor: pointer; color: #9ca3af; }
			.modal-body { margin-bottom: 24px; font-size: 14px; line-height: 1.6; color: #4b5563; }
			.modal-actions { display: flex; justify-content: flex-end; gap: 12px; }
			.secondary-btn { padding: 8px 16px; border-radius: 8px; border: 1px solid #d1d5db; background: #ffffff; font-weight: 600; cursor: pointer; }
			.primary-btn { padding: 8px 16px; border-radius: 8px; border: none; background: #5b4bdb; color: white; font-weight: 600; cursor: pointer; }
			.primary-btn.danger { background: #dc2626; }
			.primary-btn.success { background: #16a34a; }

			body.dark { color: #e8eaf0; background: #101116; }
			body.dark .auth-guard-overlay { background: #101116; }
			body.dark .navbar { background: #17181e; border-color: #282a33; }
			body.dark .logo { color: #f0f1f5; }
			body.dark .sidebar { background: #17181e; border-color: #282a33; }
			body.dark .sidebar-nav .nav-item { color: #aeb3c0; }
			body.dark .sidebar-nav .nav-item:hover, body.dark .sidebar-nav .nav-item.active { background: #211d3b; color: #a5b4fc; }
			body.dark .toolbar, body.dark .table-container, body.dark .stat-badge, body.dark .modal-card { background: #17181e; border-color: #282a33; color: #e8eaf0; }
			body.dark .search-box, body.dark .filter-group select { background: #101116; border-color: #282a33; color: #e8eaf0; }
