---
import { getCollection } from "astro:content";
import { getSupabaseConfig } from "../../lib/supabase";
import { getGitHubConfig } from "../../lib/github";

const config = getSupabaseConfig();
const githubConfig = getGitHubConfig();
const phpNotes = await getCollection("php");

const subjects = [
	{ name: "PHP", count: phpNotes.length, icon: "🐘" },
	{ name: "C", count: 0, icon: "⚙️" },
	{ name: "C++", count: 0, icon: "💻" },
	{ name: "Python", count: 0, icon: "🐍" },
	{ name: "MySQL", count: 0, icon: "🗄️" },
	{ name: "DSA", count: 0, icon: "🌳" },
];

const totalNotes = phpNotes.length;
const totalSubjects = subjects.length;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Fahad Sir Admin Dashboard | Notes By FSir</title>
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<!-- AUTH CHECK GUARD OVERLAY -->
		<div id="authGuardOverlay" class="auth-guard-overlay">
			<div class="auth-loader-card">
				<div class="spinner"></div>
				<p>Verifying Admin Security Credentials...</p>
			</div>
		</div>

		<!-- MAIN ADMIN APP -->
		<div id="adminApp" class="admin-app hidden">
			<!-- NAVBAR -->
			<header class="navbar">
				<div class="brand-group">
					<a href="/" class="logo">
						Notes By <span>FSir</span>
					</a>
					<span class="admin-badge">⚡ Admin Portal</span>
				</div>

				<div class="nav-actions">
					<span class="admin-user-pill" id="adminUserPill">
						👤 Loading...
					</span>

					<button
						id="themeToggle"
						class="theme-btn"
						aria-label="Toggle dark mode"
					>
						🌙
					</button>

					<button id="logoutBtn" class="logout-btn">
						Logout
					</button>
				</div>
			</header>

			<!-- ADMIN CONTAINER -->
			<div class="admin-layout">
				<!-- SIDEBAR NAVIGATION -->
				<aside class="sidebar">
					<div class="user-greeting">
						<h2>Welcome, Fahad Sir</h2>
						<p>System Administrator</p>
					</div>

					<nav class="sidebar-nav">
						<button class="nav-item active" data-tab="overview">
							<span>📊</span> Overview Dashboard
						</button>
						<button class="nav-item" data-tab="notes">
							<span>📚</span> Note Management
						</button>
						<button class="nav-item" data-tab="suggestions">
							<span>💡</span> Pending Suggestions
							<span class="badge" id="suggestionsBadge">0</span>
						</button>
					</nav>

					<div class="sidebar-footer">
						<a href="/" class="site-link">← View Public Website</a>
					</div>
				</aside>

				<!-- MAIN CONTENT AREA -->
				<main class="admin-main">
					<!-- TAB 1: OVERVIEW -->
					<section id="tab-overview" class="tab-pane active">
						<div class="page-header">
							<h1>Dashboard Overview</h1>
							<p>Welcome to the Fahad Sir Admin Control Center.</p>
						</div>

						<div class="stats-grid">
							<div class="stat-card">
								<div class="stat-icon purple">📚</div>
								<div class="stat-info">
									<span class="stat-label">Total Notes</span>
									<span class="stat-value">{totalNotes}</span>
								</div>
							</div>

							<div class="stat-card">
								<div class="stat-icon blue">🏷️</div>
								<div class="stat-info">
									<span class="stat-label">Total Subjects</span>
									<span class="stat-value">{totalSubjects}</span>
								</div>
							</div>

							<div class="stat-card">
								<div class="stat-icon orange">💡</div>
								<div class="stat-info">
									<span class="stat-label">Pending Suggestions</span>
									<span class="stat-value" id="statPendingSuggestions">0</span>
								</div>
							</div>

							<div class="stat-card">
								<div class="stat-icon green">👑</div>
								<div class="stat-info">
									<span class="stat-label">Logged-in Admin</span>
									<span class="stat-value small" id="statAdminEmail">admin@fsir.com</span>
								</div>
							</div>
						</div>

						<!-- QUICK SUMMARY SECTION -->
						<div class="dashboard-grid">
							<div class="panel">
								<h3>Subject Distribution</h3>
								<div class="subject-list">
									{
										subjects.map((sub) => (
											<div class="subject-item">
												<span class="sub-icon">{sub.icon}</span>
												<span class="sub-name">{sub.name}</span>
												<span class="sub-count">{sub.count} Notes</span>
											</div>
										))
									}
								</div>
							</div>

							<div class="panel">
								<h3>System Status & Security</h3>
								<div class="status-list">
									<div class="status-item">
										<span class="status-dot green"></span>
										<span>Supabase Auth Engine: <strong>Active</strong></span>
									</div>
									<div class="status-item">
										<span class="status-dot green"></span>
										<span>Row Level Security (RLS): <strong>Enforced</strong></span>
									</div>
									<div class="status-item">
										<span class={`status-dot ${githubConfig.isConfigured ? 'green' : 'orange'}`}></span>
										<span>GitHub REST API: <strong>{githubConfig.isConfigured ? `Connected (${githubConfig.branch})` : 'Config Needed'}</strong></span>
									</div>
									<div class="status-item">
										<span class="status-dot purple"></span>
										<span>Content Storage: <strong>Astro Content Collections (.md)</strong></span>
									</div>
								</div>
							</div>
						</div>
					</section>

					<!-- TAB 2: NOTES MANAGEMENT -->
					<section id="tab-notes" class="tab-pane hidden">
						<div class="page-header flex-header">
							<div>
								<h1>Note Management</h1>
								<p>Manage and organize Markdown tutorial notes.</p>
							</div>
							<a href="/admin/notes/new" class="primary-btn">
								+ Create New Note
							</a>
						</div>

						<!-- ARCHITECTURE NOTICE BOX -->
						<div class="info-callout">
							<div class="callout-header">
								<span>⚙️ Production Architecture & Markdown Content System</span>
							</div>
							<p>
								Notes in <strong>Notes By FSir</strong> are currently compiled at build time from static Markdown files stored in <code>src/content/php/*.md</code>.
							</p>
							<p class="callout-sub">
								<strong>Recommended Production Strategy for Remote Editing:</strong> To allow editing directly from the live web UI, connect this Admin dashboard to the <strong>GitHub REST API</strong> (via repository commits) or a serverless GitHub Webhook. This allows Fahad Sir to edit files securely without exposing filesystem credentials or creating uncommitted local edits!
							</p>
						</div>

						<!-- NOTES LIST TABLE -->
						<div class="table-container">
							<table class="data-table">
								<thead>
									<tr>
										<th>Chapter</th>
										<th>Title</th>
										<th>Subject</th>
										<th>Author</th>
										<th>File Path / ID</th>
										<th>Actions</th>
									</tr>
								</thead>
								<tbody>
									{
										phpNotes.map((note) => (
											<tr>
												<td>
													<span class="chapter-badge">{note.data.chapter}</span>
												</td>
												<td>
													<strong>{note.data.title}</strong>
													<br />
													<small class="text-muted">{note.data.description}</small>
												</td>
												<td><span class="subject-pill">{note.data.subject}</span></td>
												<td>{note.data.author}</td>
												<td><code>src/content/php/{note.id}.md</code></td>
												<td class="actions-cell">
													<a href={`/admin/notes/edit/${note.id}`} class="action-btn edit-note-btn">
														✏️ Edit
													</a>
													<button class="action-btn danger delete-note-btn" data-id={note.id} data-subject={note.data.subject} data-title={note.data.title}>
														🗑️ Delete
													</button>
												</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</section>

					<!-- TAB 3: SUGGESTIONS MANAGEMENT -->
					<section id="tab-suggestions" class="tab-pane hidden">
						<div class="page-header">
							<h1>Student Edit Suggestions</h1>
							<p>Review and act on suggestions submitted by students.</p>
						</div>

						<div id="suggestionsListContainer" class="table-container">
							<div class="loading-state">Fetching suggestions from Supabase database...</div>
						</div>
					</section>
				</main>
			</div>
		</div>

		<!-- ADD/EDIT NOTE MODAL -->
		<div id="noteModal" class="modal-backdrop hidden">
			<div class="modal-card">
				<div class="modal-header">
					<h3 id="modalTitle">Add / Edit Note Draft</h3>
					<button class="close-modal-btn" id="closeModalBtn">&times;</button>
				</div>
				<form id="noteModalForm" class="modal-form">
					<input type="hidden" id="noteModalId" />
					
					<div class="form-group">
						<label for="noteTitleInput">Note Title</label>
						<input type="text" id="noteTitleInput" placeholder="e.g. 2.6 File Upload in PHP" required />
					</div>

					<div class="form-group">
						<label for="noteChapterInput">Chapter Number</label>
						<input type="text" id="noteChapterInput" placeholder="e.g. 2.6" required />
					</div>

					<div class="form-group">
						<label for="noteSubjectInput">Subject</label>
						<select id="noteSubjectInput">
							<option value="PHP">PHP</option>
							<option value="C">C</option>
							<option value="C++">C++</option>
							<option value="Python">Python</option>
							<option value="MySQL">MySQL</option>
							<option value="DSA">DSA</option>
						</select>
					</div>

					<div class="form-group">
						<label for="noteDescriptionInput">Short Description</label>
						<input type="text" id="noteDescriptionInput" placeholder="Brief summary of note topic" required />
					</div>

					<div class="form-group">
						<label for="noteContentInput">Markdown Content Draft</label>
						<textarea id="noteContentInput" rows="8" placeholder="# Enter Markdown heading and details here..."></textarea>
					</div>

					<div class="modal-actions">
						<button type="button" class="secondary-btn" id="cancelModalBtn">Cancel</button>
						<button type="submit" class="primary-btn">Save Note Draft</button>
					</div>
				</form>
			</div>
		</div>

		<!-- CLIENT ADMIN SCRIPT -->
		<script is:inline define:vars={{ supabaseUrl: config.url, supabaseKey: config.anonKey, isConfigured: config.isConfigured }}>
			// Theme Toggle
			const themeButton = document.getElementById("themeToggle");
			const savedTheme = localStorage.getItem("theme");

			if (savedTheme === "dark") {
				document.body.classList.add("dark");
				if (themeButton) themeButton.textContent = "☀️";
			}

			themeButton?.addEventListener("click", () => {
				document.body.classList.toggle("dark");
				const isDark = document.body.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
				themeButton.textContent = isDark ? "☀️" : "🌙";
			});

			let supabase = null;
			let currentAdminUser = null;

			// Auth Guard Logic
			async function initAdminGuard() {
				const overlay = document.getElementById("authGuardOverlay");
				const app = document.getElementById("adminApp");

				if (!isConfigured || !supabaseUrl || !supabaseKey) {
					// Config missing, show warning or redirect
					alert("Supabase credentials not configured in .env.local! Redirecting to Login.");
					window.location.href = "/login";
					return;
				}

				try {
					const mod = await import("https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm");
					supabase = mod.createClient(supabaseUrl, supabaseKey);

					const { data: { session } } = await supabase.auth.getSession();

					if (!session) {
						// Not logged in -> redirect to login
						window.location.href = "/login";
						return;
					}

					// Verify role from database
					const { data: profile, error } = await supabase
						.from("profiles")
						.select("role, email")
						.eq("id", session.user.id)
						.single();

					if (error || !profile || profile.role !== "admin") {
						alert("Unauthorized Access: Only authenticated ADMIN users can access this page.");
						window.location.href = "/login";
						return;
					}

					currentAdminUser = session.user;

					// Display Admin Details
					const adminPill = document.getElementById("adminUserPill");
					const statAdminEmail = document.getElementById("statAdminEmail");
					if (adminPill) adminPill.textContent = `👤 ${profile.email || session.user.email}`;
					if (statAdminEmail) statAdminEmail.textContent = profile.email || session.user.email;

					// Grant Access
					overlay?.classList.add("hidden");
					app?.classList.remove("hidden");

					// Fetch Live Suggestions
					fetchSuggestions();

				} catch (err) {
					console.error("Auth guard error:", err);
					window.location.href = "/login";
				}
			}

			initAdminGuard();

			// Logout Handler
			document.getElementById("logoutBtn")?.addEventListener("click", async () => {
				if (supabase) {
					await supabase.auth.signOut();
				}
				window.location.href = "/login";
			});

			// Tab Navigation Handler
			const navItems = document.querySelectorAll(".sidebar-nav .nav-item");
			const tabPanes = document.querySelectorAll(".tab-pane");

			navItems.forEach((btn) => {
				btn.addEventListener("click", () => {
					const targetTab = btn.getAttribute("data-tab");

					navItems.forEach((item) => item.classList.remove("active"));
					btn.classList.add("active");

					tabPanes.forEach((pane) => {
						if (pane.id === `tab-${targetTab}`) {
							pane.classList.remove("hidden");
							pane.classList.add("active");
						} else {
							pane.classList.add("hidden");
							pane.classList.remove("active");
						}
					});
				});
			});

			// Live Suggestions Fetching & Handling
			async function fetchSuggestions() {
				const container = document.getElementById("suggestionsListContainer");
				const badge = document.getElementById("suggestionsBadge");
				const statPending = document.getElementById("statPendingSuggestions");

				if (!supabase || !container) return;

				try {
					const { data: suggestions, error } = await supabase
						.from("suggestions")
						.select("*")
						.order("created_at", { ascending: false });

					if (error) throw error;

					const pendingCount = suggestions?.filter(s => s.status === 'pending').length || 0;
					if (badge) badge.textContent = pendingCount;
					if (statPending) statPending.textContent = pendingCount;

					if (!suggestions || suggestions.length === 0) {
						container.innerHTML = `
							<div class="empty-state">
								<p>💡 No student suggestions found yet.</p>
							</div>
						`;
						return;
					}

					container.innerHTML = `
						<table class="data-table">
							<thead>
								<tr>
									<th>Date</th>
									<th>Note Target</th>
									<th>Suggestion Text</th>
									<th>Status</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody>
								${suggestions.map(s => `
									<tr>
										<td>${new Date(s.created_at).toLocaleDateString()}</td>
										<td><code>${s.note_id}</code></td>
										<td>${escapeHtml(s.suggestion)}</td>
										<td>
											<span class="status-badge ${s.status}">${s.status.toUpperCase()}</span>
										</td>
										<td class="actions-cell">
											${s.status === 'pending' ? `
												<button class="action-btn success approve-suggestion-btn" data-id="${s.id}">✓ Approve</button>
												<button class="action-btn danger reject-suggestion-btn" data-id="${s.id}">✕ Reject</button>
											` : `<span class="text-muted">Completed</span>`}
										</td>
									</tr>
								`).join('')}
							</tbody>
						</table>
					`;

					// Attach Event Listeners
					document.querySelectorAll(".approve-suggestion-btn").forEach(btn => {
						btn.addEventListener("click", () => updateSuggestionStatus(btn.getAttribute("data-id"), 'approved'));
					});

					document.querySelectorAll(".reject-suggestion-btn").forEach(btn => {
						btn.addEventListener("click", () => updateSuggestionStatus(btn.getAttribute("data-id"), 'rejected'));
					});

				} catch (err) {
					console.warn("Suggestions query note:", err.message);
					container.innerHTML = `
						<div class="empty-state warning">
							<p>💡 Database Table Setup Ready. Run <code>supabase_schema.sql</code> in your Supabase SQL Editor to enable live suggestions store.</p>
						</div>
					`;
				}
			}

			async function updateSuggestionStatus(id, newStatus) {
				if (!supabase) return;
				try {
					const { error } = await supabase
						.from("suggestions")
						.update({ status: newStatus })
						.eq("id", id);

					if (error) throw error;

					fetchSuggestions();
				} catch (err) {
					alert("Failed to update suggestion: " + err.message);
				}
			}

			function escapeHtml(str) {
				return str ? str.replace(/[&<>"']/g, function(m) {
					return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
				}) : '';
			}

			// Modal Note Handling UI
			const noteModal = document.getElementById("noteModal");
			const openAddNoteBtn = document.getElementById("openAddNoteBtn");
			const closeModalBtn = document.getElementById("closeModalBtn");
			const cancelModalBtn = document.getElementById("cancelModalBtn");
			const noteModalForm = document.getElementById("noteModalForm");
			const modalTitle = document.getElementById("modalTitle");

			openAddNoteBtn?.addEventListener("click", () => {
				modalTitle.textContent = "Add New Note Draft";
				noteModalForm.reset();
				document.getElementById("noteModalId").value = "";
				noteModal?.classList.remove("hidden");
			});

			closeModalBtn?.addEventListener("click", () => noteModal?.classList.add("hidden"));
			cancelModalBtn?.addEventListener("click", () => noteModal?.classList.add("hidden"));

			document.querySelectorAll(".edit-note-btn").forEach((btn) => {
				btn.addEventListener("click", () => {
					modalTitle.textContent = "Edit Note Details";
					document.getElementById("noteModalId").value = btn.getAttribute("data-id") || "";
					document.getElementById("noteTitleInput").value = btn.getAttribute("data-title") || "";
					document.getElementById("noteChapterInput").value = btn.getAttribute("data-chapter") || "";
					noteModal?.classList.remove("hidden");
				});
			});

			let sessionToken = null;

			document.querySelectorAll(".delete-note-btn").forEach((btn) => {
				btn.addEventListener("click", async () => {
					const title = btn.getAttribute("data-title");
					const noteId = btn.getAttribute("data-id");
					const subject = btn.getAttribute("data-subject") || "PHP";
					const filename = noteId.endsWith(".md") ? noteId : `${noteId}.md`;

					if (!confirm(`Are you sure you want to delete note "${title}" (${filename}) from GitHub? This action cannot be undone.`)) {
						return;
					}

					try {
						if (!sessionToken && supabase) {
							const { data: { session } } = await supabase.auth.getSession();
							if (session) sessionToken = session.access_token;
						}

						const res = await fetch("/api/notes/delete", {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"Authorization": `Bearer ${sessionToken}`,
							},
							body: JSON.stringify({
								filename,
								subject,
							}),
						});

						const data = await res.json();
						if (!res.ok) {
							throw new Error(data.error || "Failed to delete note.");
						}

						alert(`Note "${title}" deleted successfully from GitHub repository.`);
						window.location.reload();

					} catch (err) {
						alert("Delete error: " + err.message);
					}
				});
			});
		</script>

		<!-- STYLES -->
		<style>
			:global(*) {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			:global(body) {
				font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: #172033;
				background: #f7f9fc;
				transition: background 0.25s ease, color 0.25s ease;
				min-height: 100vh;
			}

			.hidden {
				display: none !important;
			}

			/* AUTH GUARD OVERLAY */
			.auth-guard-overlay {
				position: fixed;
				inset: 0;
				background: #ffffff;
				z-index: 999;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.auth-loader-card {
				text-align: center;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 16px;
			}

			.spinner {
				width: 44px;
				height: 44px;
				border: 4px solid #e0e4f0;
				border-top-color: #5b4bdb;
				border-radius: 50%;
				animation: spin 0.8s linear infinite;
			}

			@keyframes spin {
				to { transform: rotate(360deg); }
			}

			/* NAVBAR */
			.navbar {
				height: 70px;
				padding: 0 4%;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid #e9ebf1;
				background: #ffffff;
				position: sticky;
				top: 0;
				z-index: 100;
			}

			.brand-group {
				display: flex;
				align-items: center;
				gap: 14px;
			}

			.logo {
				color: #172033;
				text-decoration: none;
				font-size: 22px;
				font-weight: 800;
			}

			.logo span {
				color: #5b4bdb;
			}

			.admin-badge {
				background: #f2efff;
				border: 1px solid #e6e2ff;
				color: #5b4bdb;
				padding: 4px 10px;
				border-radius: 20px;
				font-size: 12px;
				font-weight: 700;
			}

			.nav-actions {
				display: flex;
				align-items: center;
				gap: 14px;
			}

			.admin-user-pill {
				font-size: 14px;
				font-weight: 600;
				color: #4b5563;
				background: #f3f4f6;
				padding: 6px 12px;
				border-radius: 8px;
			}

			.theme-btn, .logout-btn {
				border: 1px solid #dddff0;
				background: white;
				cursor: pointer;
				font-weight: 600;
				font-size: 14px;
				color: #172033;
				border-radius: 8px;
			}

			.theme-btn {
				width: 38px;
				height: 38px;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.logout-btn {
				padding: 8px 16px;
				background: #fee2e2;
				color: #dc2626;
				border-color: #fca5a5;
				transition: background 0.2s ease;
			}

			.logout-btn:hover {
				background: #fca5a5;
			}

			/* LAYOUT */
			.admin-layout {
				display: grid;
				grid-template-columns: 260px 1fr;
				min-height: calc(100vh - 70px);
			}

			/* SIDEBAR */
			.sidebar {
				background: #ffffff;
				border-right: 1px solid #e9ebf1;
				padding: 30px 20px;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			.user-greeting {
				margin-bottom: 24px;
			}

			.user-greeting h2 {
				font-size: 18px;
				font-weight: 800;
				color: #172033;
			}

			.user-greeting p {
				font-size: 13px;
				color: #6b7280;
			}

			.sidebar-nav {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}

			.nav-item {
				display: flex;
				align-items: center;
				gap: 12px;
				padding: 12px 14px;
				border-radius: 10px;
				border: none;
				background: transparent;
				color: #4b5563;
				font-size: 14px;
				font-weight: 600;
				cursor: pointer;
				text-align: left;
				transition: all 0.2s ease;
				width: 100%;
			}

			.nav-item:hover {
				background: #f3f4f6;
				color: #172033;
			}

			.nav-item.active {
				background: #5b4bdb;
				color: #ffffff;
			}

			.nav-item .badge {
				margin-left: auto;
				background: #ef4444;
				color: white;
				font-size: 11px;
				padding: 2px 7px;
				border-radius: 10px;
			}

			.sidebar-footer {
				margin-top: 40px;
				padding-top: 20px;
				border-top: 1px solid #e9ebf1;
			}

			.site-link {
				color: #5b4bdb;
				text-decoration: none;
				font-size: 14px;
				font-weight: 600;
			}

			/* MAIN CONTENT */
			.admin-main {
				padding: 36px 40px;
			}

			.page-header {
				margin-bottom: 28px;
			}

			.page-header.flex-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.page-header h1 {
				font-size: 26px;
				font-weight: 800;
				color: #172033;
				margin-bottom: 4px;
			}

			.page-header p {
				color: #6b7280;
				font-size: 14px;
			}

			/* STAT CARDS */
			.stats-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 20px;
				margin-bottom: 32px;
			}

			.stat-card {
				background: #ffffff;
				border: 1px solid #e5e7eb;
				border-radius: 16px;
				padding: 20px;
				display: flex;
				align-items: center;
				gap: 16px;
				box-shadow: 0 2px 5px rgba(0,0,0,0.02);
			}

			.stat-icon {
				width: 50px;
				height: 50px;
				border-radius: 12px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 24px;
			}

			.stat-icon.purple { background: #f2efff; }
			.stat-icon.blue { background: #eff6ff; }
			.stat-icon.orange { background: #fff7ed; }
			.stat-icon.green { background: #f0fdf4; }

			.stat-info {
				display: flex;
				flex-direction: column;
			}

			.stat-label {
				font-size: 13px;
				color: #6b7280;
				font-weight: 600;
			}

			.stat-value {
				font-size: 24px;
				font-weight: 800;
				color: #111827;
			}

			.stat-value.small {
				font-size: 14px;
				word-break: break-all;
			}

			/* PANELS */
			.dashboard-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 24px;
			}

			.panel {
				background: #ffffff;
				border: 1px solid #e5e7eb;
				border-radius: 16px;
				padding: 24px;
			}

			.panel h3 {
				font-size: 17px;
				font-weight: 700;
				color: #111827;
				margin-bottom: 18px;
			}

			.subject-list {
				display: flex;
				flex-direction: column;
				gap: 12px;
			}

			.subject-item {
				display: flex;
				align-items: center;
				padding: 10px 14px;
				background: #f9fafb;
				border-radius: 10px;
			}

			.sub-icon { margin-right: 10px; font-size: 18px; }
			.sub-name { font-weight: 600; flex: 1; }
			.sub-count { font-size: 13px; color: #6b7280; }

			.status-list {
				display: flex;
				flex-direction: column;
				gap: 14px;
			}

			.status-item {
				display: flex;
				align-items: center;
				gap: 10px;
				font-size: 14px;
				color: #374151;
			}

			.status-dot {
				width: 10px;
				height: 10px;
				border-radius: 50%;
			}

			.status-dot.green { background: #10b981; }
			.status-dot.purple { background: #5b4bdb; }

			/* CALLOUT BOX */
			.info-callout {
				background: #f0f4ff;
				border: 1px solid #c7d2fe;
				border-radius: 14px;
				padding: 20px;
				margin-bottom: 24px;
				color: #1e1b4b;
			}

			.callout-header {
				font-weight: 700;
				font-size: 15px;
				margin-bottom: 8px;
			}

			.callout-sub {
				margin-top: 10px;
				font-size: 13px;
				line-height: 1.5;
			}

			/* TABLE CONTAINER */
			.table-container {
				background: #ffffff;
				border: 1px solid #e5e7eb;
				border-radius: 16px;
				overflow: hidden;
			}

			.data-table {
				width: 100%;
				border-collapse: collapse;
				text-align: left;
			}

			.data-table th {
				background: #f9fafb;
				padding: 14px 18px;
				font-size: 13px;
				font-weight: 700;
				color: #374151;
				border-bottom: 1px solid #e5e7eb;
			}

			.data-table td {
				padding: 14px 18px;
				font-size: 14px;
				border-bottom: 1px solid #e5e7eb;
				color: #1f2937;
			}

			.chapter-badge {
				background: #f3f4f6;
				padding: 4px 8px;
				border-radius: 6px;
				font-weight: 700;
				font-size: 12px;
			}

			.subject-pill {
				background: #f2efff;
				color: #5b4bdb;
				padding: 4px 10px;
				border-radius: 12px;
				font-size: 12px;
				font-weight: 600;
			}

			.actions-cell {
				display: flex;
				gap: 8px;
			}

			.action-btn {
				padding: 6px 12px;
				border-radius: 6px;
				border: 1px solid #d1d5db;
				background: #ffffff;
				font-size: 13px;
				font-weight: 600;
				cursor: pointer;
			}

			.action-btn.danger {
				background: #fef2f2;
				border-color: #fca5a5;
				color: #991b1b;
			}

			.action-btn.success {
				background: #f0fdf4;
				border-color: #86efac;
				color: #166534;
			}

			.primary-btn {
				background: #5b4bdb;
				color: white;
				padding: 10px 18px;
				border-radius: 10px;
				border: none;
				font-size: 14px;
				font-weight: 700;
				cursor: pointer;
			}

			.status-badge {
				padding: 4px 10px;
				border-radius: 12px;
				font-size: 11px;
				font-weight: 700;
			}

			.status-badge.pending { background: #fef3c7; color: #92400e; }
			.status-badge.approved { background: #dcfce7; color: #166534; }
			.status-badge.rejected { background: #fee2e2; color: #991b1b; }

			.loading-state, .empty-state {
				padding: 40px;
				text-align: center;
				color: #6b7280;
			}

			/* MODAL */
			.modal-backdrop {
				position: fixed;
				inset: 0;
				background: rgba(0,0,0,0.4);
				z-index: 200;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.modal-card {
				background: white;
				border-radius: 18px;
				width: 100%;
				max-width: 600px;
				padding: 28px;
				box-shadow: 0 20px 40px rgba(0,0,0,0.15);
			}

			.modal-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 20px;
			}

			.close-modal-btn {
				background: none;
				border: none;
				font-size: 24px;
				cursor: pointer;
			}

			.modal-form {
				display: flex;
				flex-direction: column;
				gap: 16px;
			}

			.modal-form input, .modal-form select, .modal-form textarea {
				width: 100%;
				padding: 10px 14px;
				border-radius: 8px;
				border: 1px solid #d1d5db;
				font-family: inherit;
			}

			.modal-actions {
				display: flex;
				justify-content: flex-end;
				gap: 12px;
				margin-top: 10px;
			}

			.secondary-btn {
				background: #f3f4f6;
				border: 1px solid #d1d5db;
				padding: 10px 16px;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
			}

			/* DARK MODE STYLES */
			body.dark {
				color: #e8eaf0;
				background: #101116;
			}

			body.dark .auth-guard-overlay {
				background: #101116;
				color: #e8eaf0;
			}

			body.dark .navbar, body.dark .sidebar {
				background: #17181e;
				border-color: #282a33;
			}

			body.dark .logo { color: #f0f1f5; }
			body.dark .admin-user-pill { background: #282a33; color: #e8eaf0; }
			body.dark .theme-btn { background: #191a21; border-color: #30323d; color: #e8eaf0; }
			body.dark .user-greeting h2, body.dark .page-header h1 { color: #f0f1f5; }
			body.dark .user-greeting p, body.dark .page-header p { color: #9ca3af; }

			body.dark .nav-item { color: #9ca3af; }
			body.dark .nav-item:hover { background: #282a33; color: #ffffff; }

			body.dark .stat-card, body.dark .panel, body.dark .table-container, body.dark .modal-card {
				background: #17181e;
				border-color: #282a33;
			}

			body.dark .stat-value, body.dark .panel h3, body.dark .data-table td { color: #f0f1f5; }
			body.dark .data-table th { background: #20222a; border-color: #282a33; color: #d1d5db; }
			body.dark .data-table td { border-color: #282a33; }
			body.dark .subject-item { background: #20222a; }
			body.dark .info-callout { background: #1e1b4b; border-color: #3730a3; color: #e0e7ff; }

			body.dark .action-btn { background: #20222a; border-color: #374151; color: #e5e7eb; }
			body.dark .modal-form input, body.dark .modal-form select, body.dark .modal-form textarea {
				background: #101116;
				border-color: #374151;
				color: #e5e7eb;
			}

			@media (max-width: 900px) {
				.admin-layout {
					grid-template-columns: 1fr;
				}
				.sidebar {
					display: none;
				}
				.stats-grid {
					grid-template-columns: 1fr 1fr;
				}
				.dashboard-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 600px) {
				.stats-grid {
					grid-template-columns: 1fr;
				}
				.admin-main {
					padding: 20px 16px;
				}
			}
		</style>
	</body>
</html>
