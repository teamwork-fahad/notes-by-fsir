---
const appId = import.meta.env.PUBLIC_ALGOLIA_APP_ID || import.meta.env.ALGOLIA_APP_ID || "";
const searchApiKey = import.meta.env.PUBLIC_ALGOLIA_SEARCH_API_KEY || import.meta.env.ALGOLIA_SEARCH_API_KEY || "";
const indexName = import.meta.env.PUBLIC_ALGOLIA_INDEX_NAME || import.meta.env.ALGOLIA_INDEX_NAME || "notes_by_fsir";
---

<div id="algoliaSearchModal" class="algolia-modal-backdrop" aria-hidden="true" hidden>
  <div class="algolia-modal-container" role="dialog" aria-modal="true" aria-label="Search notes">
    
    <!-- Modal Header -->
    <div class="algolia-modal-header">
      <div class="algolia-search-input-wrapper">
        <span class="algolia-search-icon" aria-hidden="true">🔍</span>
        <input
          id="algoliaModalInput"
          type="search"
          placeholder="Search notes, topics, C, Python, MySQL..."
          autocomplete="off"
          autofocus
        />
        <button id="algoliaClearInputBtn" class="algolia-clear-input-btn" type="button" aria-label="Clear input" hidden>✕</button>
      </div>
      <button id="algoliaCloseBtn" class="algolia-close-btn" type="button" aria-label="Close search">✕</button>
    </div>

    <!-- Modal Body / Results -->
    <div id="algoliaResultsContainer" class="algolia-results-body">
      <div class="algolia-initial-state">
        <div class="algolia-icon-hero">📚</div>
        <h3>Instant Search Notes & Topics</h3>
        <p>Type any keyword, programming concept, or topic name...</p>

        <div class="algolia-quick-links">
          <span class="algolia-quick-label">Try searching:</span>
          <button type="button" class="algolia-chip" data-query="Python">🐍 Python</button>
          <button type="button" class="algolia-chip" data-query="C++">💻 C++</button>
          <button type="button" class="algolia-chip" data-query="MySQL">🗄️ MySQL</button>
          <button type="button" class="algolia-chip" data-query="Functions">⚙️ Functions</button>
          <button type="button" class="algolia-chip" data-query="Arrays">🔢 Arrays</button>
          <button type="button" class="algolia-chip" data-query="Pointers">📍 Pointers</button>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="algolia-modal-footer">
      <div class="algolia-footer-brand">
        <span>Powered by <strong>Algolia</strong></span>
      </div>
      <div class="algolia-shortcuts-hint">
        <kbd>↑</kbd> <kbd>↓</kbd> navigate · <kbd>↵</kbd> open · <kbd>ESC</kbd> close
      </div>
    </div>
  </div>
</div>

<style>
  .algolia-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: max(60px, 8vh);
    background: rgba(15, 23, 42, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fadeIn 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .algolia-modal-container {
    width: min(740px, calc(100vw - 24px));
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    background: var(--surface, #fffdf8);
    color: var(--ink, #17212b);
    border: 1px solid var(--line, #ded8ce);
    border-radius: 16px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    transition: transform 150ms ease;
  }

  /* Dark theme overrides */
  :global(body.dark) .algolia-modal-container {
    background: var(--surface, #1d3030);
    color: var(--ink, #f5f1e8);
    border-color: var(--line, #385252);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
  }

  /* Header */
  .algolia-modal-header {
    display: flex;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line, #ded8ce);
    gap: 12px;
    background: var(--surface, #fffdf8);
  }
  :global(body.dark) .algolia-modal-header {
    background: var(--surface, #1d3030);
    border-color: var(--line, #385252);
  }

  .algolia-search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    background: var(--paper, #f6f1e9);
    padding: 8px 14px;
    border-radius: 10px;
    border: 1px solid var(--line, #ded8ce);
    transition: border-color 150ms ease;
  }
  :global(body.dark) .algolia-search-input-wrapper {
    background: var(--paper, #152326);
    border-color: var(--line, #385252);
  }
  .algolia-search-input-wrapper:focus-within {
    border-color: var(--coral, #e86d52);
  }

  .algolia-search-icon {
    font-size: 1.1rem;
    opacity: 0.7;
    flex-shrink: 0;
  }

  .algolia-search-input-wrapper input {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    color: var(--ink, #17212b);
    font-family: inherit;
    font-size: 1rem;
    font-weight: 500;
  }
  :global(body.dark) .algolia-search-input-wrapper input {
    color: var(--ink, #f5f1e8);
  }

  .algolia-clear-input-btn {
    border: none;
    background: transparent;
    color: var(--muted, #65717a);
    font-size: 0.9rem;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 50%;
  }

  .algolia-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    min-height: 38px;
    border: 1px solid var(--line, #ded8ce);
    background: var(--paper, #f6f1e9);
    color: var(--muted, #65717a);
    font-size: 1.1rem;
    cursor: pointer;
    border-radius: 10px;
    transition: all 150ms ease;
    flex-shrink: 0;
  }
  :global(body.dark) .algolia-close-btn {
    background: var(--paper, #152326);
    border-color: var(--line, #385252);
    color: var(--muted, #aebdb9);
  }
  .algolia-close-btn:hover {
    color: var(--coral, #e86d52);
    border-color: var(--coral, #e86d52);
  }

  /* Body */
  .algolia-results-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    min-height: 240px;
    max-height: 560px;
    -webkit-overflow-scrolling: touch;
  }

  .algolia-initial-state {
    padding: 32px 16px;
    text-align: center;
    color: var(--muted, #65717a);
  }
  :global(body.dark) .algolia-initial-state {
    color: var(--muted, #aebdb9);
  }

  .algolia-icon-hero {
    font-size: 2.5rem;
    margin-bottom: 8px;
  }

  .algolia-initial-state h3 {
    margin: 6px 0 4px;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.2rem;
    color: var(--ink, #17212b);
  }
  :global(body.dark) .algolia-initial-state h3 {
    color: var(--ink, #f5f1e8);
  }

  .algolia-initial-state p {
    margin: 0;
    font-size: 0.92rem;
  }

  .algolia-quick-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .algolia-quick-label {
    width: 100%;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--teal, #176d6b);
    margin-bottom: 4px;
  }

  .algolia-chip {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line, #ded8ce);
    background: var(--paper, #f6f1e9);
    color: var(--ink, #17212b);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 150ms ease;
  }
  :global(body.dark) .algolia-chip {
    background: var(--paper, #152326);
    border-color: var(--line, #385252);
    color: var(--ink, #f5f1e8);
  }
  .algolia-chip:hover {
    border-color: var(--coral, #e86d52);
    color: var(--coral, #e86d52);
    transform: translateY(-2px);
  }

  /* Result Items */
  .algolia-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px 10px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted, #65717a);
  }

  .algolia-result-item {
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line, #ded8ce);
    background: var(--surface, #fffdf8);
    transition: all 140ms ease;
    margin-bottom: 10px;
  }
  :global(body.dark) .algolia-result-item {
    background: var(--paper, #152326);
    border-color: var(--line, #385252);
  }

  .algolia-result-item:hover,
  .algolia-result-item.selected {
    border-color: var(--coral, #e86d52);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
  }
  :global(body.dark) .algolia-result-item:hover,
  :global(body.dark) .algolia-result-item.selected {
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  }

  .algolia-result-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .algolia-badge {
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--coral, #e86d52);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .algolia-result-title {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink, #17212b);
    margin: 0;
    flex: 1;
    min-width: 200px;
  }
  :global(body.dark) .algolia-result-title {
    color: var(--ink, #f5f1e8);
  }

  .algolia-result-chapter {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(23, 109, 107, 0.12);
    color: var(--teal, #176d6b);
  }
  :global(body.dark) .algolia-result-chapter {
    background: rgba(23, 109, 107, 0.35);
    color: #6edfdc;
  }

  .algolia-result-snippet {
    margin: 6px 0 0;
    font-size: 0.9rem;
    color: var(--muted, #65717a);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(body.dark) .algolia-result-snippet {
    color: var(--muted, #aebdb9);
  }

  .algolia-result-snippet mark,
  .algolia-result-title mark {
    background: rgba(242, 201, 76, 0.4);
    color: inherit;
    font-weight: 700;
    padding: 1px 4px;
    border-radius: 3px;
  }

  .algolia-no-results {
    padding: 40px 16px;
    text-align: center;
    color: var(--muted, #65717a);
  }

  /* Footer */
  .algolia-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    border-top: 1px solid var(--line, #ded8ce);
    background: var(--paper, #f6f1e9);
    font-size: 0.8rem;
    color: var(--muted, #65717a);
  }
  :global(body.dark) .algolia-modal-footer {
    background: var(--paper, #152326);
    border-color: var(--line, #385252);
    color: var(--muted, #aebdb9);
  }

  .algolia-shortcuts-hint kbd {
    padding: 2px 5px;
    border-radius: 4px;
    border: 1px solid var(--line, #ded8ce);
    background: var(--surface, #fffdf8);
    font-size: 0.7rem;
    font-weight: 600;
  }
  :global(body.dark) .algolia-shortcuts-hint kbd {
    background: var(--surface, #1d3030);
    border-color: var(--line, #385252);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Mobile Responsive Fixes */
  @media (max-width: 640px) {
    .algolia-modal-backdrop {
      padding-top: 0;
      align-items: flex-start;
    }
    .algolia-modal-container {
      width: 100vw;
      height: 100vh;
      max-height: 100vh;
      border-radius: 0;
      border: none;
    }
    .algolia-search-input-wrapper input {
      font-size: 16px; /* Prevents Safari auto-zoom on mobile */
    }
    .algolia-shortcuts-hint {
      display: none;
    }
    .algolia-result-item {
      padding: 16px 14px;
    }
    .algolia-results-body {
      max-height: calc(100vh - 120px);
    }
  }
</style>

<script is:inline define:vars={{ appId, searchApiKey, indexName }}>
  (function () {
    const modal = document.getElementById("algoliaSearchModal");
    const input = document.getElementById("algoliaModalInput");
    const closeBtn = document.getElementById("algoliaCloseBtn");
    const clearBtn = document.getElementById("algoliaClearInputBtn");
    const container = document.getElementById("algoliaResultsContainer");

    if (!modal || !input || !container) return;

    let selectedIdx = -1;

    function openModal(initialQuery = "") {
      modal.hidden = false;
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      input.value = initialQuery;
      toggleClearButton();
      setTimeout(() => input.focus(), 50);

      if (initialQuery.trim()) {
        performSearch(initialQuery);
      }
    }

    function closeModal() {
      modal.hidden = true;
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      selectedIdx = -1;
    }

    function toggleClearButton() {
      if (clearBtn) {
        clearBtn.hidden = !input.value.trim();
      }
    }

    closeBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      closeModal();
    });

    clearBtn?.addEventListener("click", () => {
      input.value = "";
      toggleClearButton();
      input.focus();
      performSearch("");
    });

    // Close when clicking dark background outside container
    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Keyboard navigation (Ctrl+K, Esc)
    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (modal.hidden) openModal(); else closeModal();
      } else if (e.key === "Escape" && !modal.hidden) {
        closeModal();
      }
    });

    // Attach click handlers to any search input elements on page
    document.querySelectorAll("#homeSearch, #noteSearch, [data-algolia-trigger]").forEach((el) => {
      el.addEventListener("focus", (e) => {
        e.preventDefault();
        openModal(el.value || "");
      });
      el.addEventListener("click", (e) => {
        e.preventDefault();
        openModal(el.value || "");
      });
    });

    // Wire quick query chips
    function bindChips() {
      document.querySelectorAll(".algolia-chip").forEach((chip) => {
        chip.addEventListener("click", () => {
          const q = chip.getAttribute("data-query") || "";
          input.value = q;
          toggleClearButton();
          input.focus();
          performSearch(q);
        });
      });
    }
    bindChips();

    // Input debounce search
    let debounceTimer = null;
    input.addEventListener("input", () => {
      toggleClearButton();
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(input.value.trim());
      }, 150);
    });

    // Keyboard Arrow navigation
    input.addEventListener("keydown", (e) => {
      const items = container.querySelectorAll(".algolia-result-item");
      if (!items.length) return;

      if (e.key === "ArrowDown") {
        e.preventDefault();
        selectedIdx = Math.min(selectedIdx + 1, items.length - 1);
        updateSelection(items);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        selectedIdx = Math.max(selectedIdx - 1, 0);
        updateSelection(items);
      } else if (e.key === "Enter" && selectedIdx >= 0) {
        e.preventDefault();
        const target = items[selectedIdx];
        if (target) {
          closeModal();
          window.location.href = target.getAttribute("href");
        }
      }
    });

    function updateSelection(items) {
      items.forEach((item, idx) => {
        if (idx === selectedIdx) {
          item.classList.add("selected");
          item.scrollIntoView({ block: "nearest" });
        } else {
          item.classList.remove("selected");
        }
      });
    }

    async function performSearch(query) {
      if (!query) {
        container.innerHTML = `
          <div class="algolia-initial-state">
            <div class="algolia-icon-hero">📚</div>
            <h3>Instant Search Notes & Topics</h3>
            <p>Type any keyword, programming concept, or topic name...</p>
            <div class="algolia-quick-links">
              <span class="algolia-quick-label">Try searching:</span>
              <button type="button" class="algolia-chip" data-query="Python">🐍 Python</button>
              <button type="button" class="algolia-chip" data-query="C++">💻 C++</button>
              <button type="button" class="algolia-chip" data-query="MySQL">🗄️ MySQL</button>
              <button type="button" class="algolia-chip" data-query="Functions">⚙️ Functions</button>
              <button type="button" class="algolia-chip" data-query="Arrays">🔢 Arrays</button>
              <button type="button" class="algolia-chip" data-query="Pointers">📍 Pointers</button>
            </div>
          </div>
        `;
        bindChips();
        return;
      }

      if (!appId || !searchApiKey) {
        container.innerHTML = `
          <div class="algolia-no-results">
            <p>ℹ️ Algolia credentials not configured yet.</p>
            <small>Set <code>PUBLIC_ALGOLIA_APP_ID</code> & <code>PUBLIC_ALGOLIA_SEARCH_API_KEY</code> in Vercel / .env.local</small>
          </div>
        `;
        return;
      }

      container.innerHTML = `<div class="algolia-initial-state"><div class="algolia-icon-hero">⏳</div><p>Searching Algolia...</p></div>`;

      try {
        const response = await fetch(`https://${appId}-dsn.algolia.net/1/indexes/${indexName}/query`, {
          method: "POST",
          headers: {
            "X-Algolia-Application-Id": appId,
            "X-Algolia-API-Key": searchApiKey,
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            query: query,
            hitsPerPage: 12,
            attributesToHighlight: ["title", "description", "content", "subject"],
            attributesToSnippet: ["content:25"]
          })
        });

        if (!response.ok) {
          throw new Error(`Algolia response status: ${response.status}`);
        }

        const data = await response.json();
        const hits = data.hits || [];

        if (hits.length === 0) {
          container.innerHTML = `
            <div class="algolia-no-results">
              <div class="algolia-icon-hero">🔍</div>
              <h3>No notes found for "${escapeHtml(query)}"</h3>
              <p style="margin-top:6px; font-size:14px;">Try searching for general terms like "variables", "loops", "arrays", or "pointers".</p>
            </div>
          `;
          return;
        }

        selectedIdx = -1;
        let html = `<div class="algolia-meta-bar"><span>Found ${hits.length} matching result${hits.length === 1 ? '' : 's'}</span></div>`;

        hits.forEach((hit) => {
          const title = getHighlighted(hit, "title") || hit.title || hit.noteTitle || "Note";
          const snippet = getHighlighted(hit, "content") || hit.description || "";
          const subject = hit.subject || hit.subjectSlug || "Note";
          const chapter = hit.chapter || "General";
          const url = hit.url || `/${hit.subjectSlug}/${hit.slug}`;

          html += `
            <a href="${url}" class="algolia-result-item" data-result-link>
              <div class="algolia-result-header">
                <span class="algolia-badge">${escapeHtml(subject)}</span>
                <h4 class="algolia-result-title">${title}</h4>
                <span class="algolia-result-chapter">${escapeHtml(chapter)}</span>
              </div>
              <p class="algolia-result-snippet">${snippet}</p>
            </a>
          `;
        });

        container.innerHTML = html;

        // Auto close modal when clicking any search result link
        container.querySelectorAll("[data-result-link]").forEach((item) => {
          item.addEventListener("click", () => {
            closeModal();
          });
        });

      } catch (err) {
        console.error("Algolia Search Error:", err);
        container.innerHTML = `
          <div class="algolia-no-results">
            <p>⚠️ Unable to fetch search results from Algolia.</p>
            <small>${escapeHtml(err.message)}</small>
          </div>
        `;
      }
    }

    function getHighlighted(hit, field) {
      if (hit._highlightResult && hit._highlightResult[field] && hit._highlightResult[field].value) {
        return hit._highlightResult[field].value;
      }
      if (hit._snippetResult && hit._snippetResult[field] && hit._snippetResult[field].value) {
        return hit._snippetResult[field].value;
      }
      return null;
    }

    function escapeHtml(str) {
      if (!str) return "";
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  })();
</script>
