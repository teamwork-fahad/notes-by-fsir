---
import "../styles/site.css";
import AlgoliaVerification from "./AlgoliaVerification.astro";
import AlgoliaSearchModal from "./AlgoliaSearchModal.astro";

interface Props {
  post: any;
  content: any;
  headings: any[];
  slug: string;
  label: string;
}

const { post, content: Content, headings, slug, label } = Astro.props;
const isUnpublished = post.data.published === false;
const tocItems = headings ? headings.filter((heading) => heading.depth === 2 || heading.depth === 3) : [];
const chapter = post.data.chapter ?? "General";
const author = post.data.author ?? "Fahad Sir";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{post.data.title} | Notes By FSir</title>
    <meta name="description" content={post.data.description ?? `${label} note by Fahad Sir`} />
    <AlgoliaVerification />
    {slug === "maths" && (
      <>
        <script is:inline>
          window.MathJax = {
            tex: {
              inlineMath: [['$', '$'], ['\\(', '\\)']],
              displayMath: [['$$', '$$'], ['\\[', '\\]']],
              processEscapes: true
            },
            options: {
              skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
            },
            svg: { fontCache: 'global' }
          };
        </script>
        <script is:inline type="text/javascript" id="MathJax-script" async
          src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js">
        </script>
      </>
    )}
  </head>
  <body>
    <header class="navbar">
      <a href="/" class="logo">Notes By <span>FSir</span></a>
      <nav><a href="/">Home</a><a href="/#subjects">Subjects</a><a href="/#about">About</a></nav>
      <div class="nav-actions">
        <button id="themeToggle" class="theme-btn" aria-label="Toggle theme">moon</button>
        <a href={`/${slug}`} class="back-btn">Back to {label}</a>
      </div>
    </header>

    <main class="page-wrapper note-reader">
      <div class="breadcrumb"><a href="/">Home</a><span>/</span><a href={`/${slug}`}>{label}</a><span>/</span><span>{post.data.title}</span></div>
      
      {isUnpublished ? (
        <div style="max-width: 800px; margin: 40px auto; padding: 32px; background: #fff8e6; border: 1px solid #ffe8b3; border-radius: 16px; text-align: center; color: #8a6d3b;">
          <h2>🔒 Draft Note (Unpublished)</h2>
          <p style="margin-top: 10px; font-size: 15px;">This note is currently unpublished by the Administrator and is not available for public reading.</p>
          <a href={`/${slug}`} class="back-btn" style="display: inline-block; margin-top: 20px; text-decoration: none;">← Return to {label} Index</a>
        </div>
      ) : (
        <div class="layout">
          <article class="article">
            <header class="article-header">
              <div class="article-meta"><span class="subject-badge">{label} · {chapter}</span><span class="author">By {author}</span></div>
              <h1>{post.data.title}</h1>
              {post.data.description && <p class="description">{post.data.description}</p>}
            </header>
            <div class="reading-progress"><div id="progressBar"></div></div>
            <div class="content"><Content /></div>
            <div class="end-note"><strong>Topic completed</strong><span>Keep learning and practicing.</span></div>
          </article>

          <aside class="toc-sidebar">
            <div class="toc-card">
              <div class="toc-heading"><strong>On this page</strong><span>{tocItems.length}</span></div>
              {tocItems.length > 0 ? <nav class="toc-links">{tocItems.map((item) => <a class:list={{ "toc-subitem": item.depth === 3 }} href={`#${item.slug}`}>{item.text}</a>)}</nav> : <p class="toc-empty">This note has no sections yet.</p>}
            </div>
          </aside>
        </div>
      )}
    </main>

    <footer><div class="footer-logo">Notes By <span>FSir</span></div><p>Created by Fahad Sir</p><small>© 2026 Notes By FSir. All rights reserved.</small></footer>

    <script>
      const themeButton = document.getElementById("themeToggle");
      if (localStorage.getItem("theme") === "dark") document.body.classList.add("dark");
      const updateTheme = () => { if (themeButton) themeButton.textContent = document.body.classList.contains("dark") ? "sun" : "moon"; };
      updateTheme();
      themeButton?.addEventListener("click", () => { document.body.classList.toggle("dark"); localStorage.setItem("theme", document.body.classList.contains("dark") ? "dark" : "light"); updateTheme(); });

      const progressBar = document.getElementById("progressBar");
      const updateProgress = () => { const article = document.querySelector(".content"); if (!article || !progressBar) return; const top = article.getBoundingClientRect().top + window.scrollY; const total = article.scrollHeight - window.innerHeight; progressBar.style.width = `${Math.min(100, Math.max(0, ((window.scrollY - top + 80) / total) * 100))}%`; };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();

      // Wrap tables automatically for responsive overflow & border handling
      document.querySelectorAll(".content table").forEach((table) => {
        if (table.parentElement?.classList.contains("table-wrapper")) return;
        const wrapper = document.createElement("div");
        wrapper.className = "table-wrapper";
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      });

      // Code Block Copy Buttons
      document.querySelectorAll(".content pre").forEach((pre) => {
        const code = pre.querySelector("code");
        if (!code || pre.parentElement?.classList.contains("code-block-container")) return;
        const container = document.createElement("div"); container.className = "code-block-container";
        const header = document.createElement("div"); header.className = "code-block-header";
        const label = document.createElement("span"); label.textContent = "CODE"; label.className = "code-block-language";
        const button = document.createElement("button"); button.textContent = "Copy"; button.className = "copy-code-btn";
        button.addEventListener("click", async () => { await navigator.clipboard.writeText(code.innerText); button.textContent = "Copied"; setTimeout(() => { button.textContent = "Copy"; }, 1200); });
        header.append(label, button); pre.parentNode?.insertBefore(container, pre); container.append(header, pre);
      });

      // Table of Contents Active Highlighting & Smooth Navigation
      const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-links a"));
      if (tocLinks.length > 0) {
        const headingsMap = tocLinks
          .map((link) => {
            const href = link.getAttribute("href");
            const id = href && href.startsWith("#") ? href.substring(1) : null;
            const target = id ? document.getElementById(id) : null;
            return { link, target, id };
          })
          .filter((item): item is { link: HTMLAnchorElement; target: HTMLElement; id: string } => item.target !== null);

        headingsMap.forEach(({ link, target, id }) => {
          link.addEventListener("click", (e) => {
            e.preventDefault();
            const top = target.getBoundingClientRect().top + window.scrollY - 90;
            window.scrollTo({ top, behavior: "smooth" });
            history.pushState(null, "", `#${id}`);
          });
        });

        const onScrollTOC = () => {
          const scrollPos = window.scrollY + 120;
          let current = null;

          for (let i = 0; i < headingsMap.length; i++) {
            const top = headingsMap[i].target.getBoundingClientRect().top + window.scrollY;
            if (scrollPos >= top) {
              current = headingsMap[i];
            }
          }

          headingsMap.forEach((item) => {
            if (current && item.id === current.id) {
              item.link.classList.add("active");
            } else {
              item.link.classList.remove("active");
            }
          });
        };

        window.addEventListener("scroll", onScrollTOC, { passive: true });
        onScrollTOC();
      }
    </script>
    <AlgoliaSearchModal />
  </body>
</html>
